# GEDv2 — copier en .env et adapter
APP_ENV=dev
APP_URL=http://127.0.0.1:8870
DB_HOST=127.0.0.1
DB_PORT=3307
DB_NAME=gedv2
DB_USER=root
DB_PASS=
# Racine documentaire : LE DOSSIER FAIT FOI
STORAGE_ROOT=storage/documents
# Propriétaire de la GED (destinataire du courrier) : jamais correspondant
GED_ORGANISATION=
# Ingestion : deux portes d'entrée (Gmail / Microsoft 365 / règles de tri : ClearMyMails)
INGESTION_DOSSIER=
INGESTION_TRAVAIL=var/ingestion
INGESTION_IMAP_HOTE=
INGESTION_IMAP_PORT=993
INGESTION_IMAP_UTILISATEUR=
INGESTION_IMAP_MOT_DE_PASSE=
# Expéditeurs acceptés (adresses ou @domaine), vide = tous
INGESTION_IMAP_EXPEDITEURS=
# Moteur de découpe ClearMyDocs v4
CMD4_PYTHON=
CMD4_PRODUIT=
# TSA RFC 3161 réelle ; simulée en test. Laisser vide seulement si l’horodatage externe n’est pas configuré.
TSA_URL=
# Appairage ClearMyMails : courriel d'auto-configuration et vérification d'adresse.
# Transport « smtp » en production, « fichier » en test (écrit le .eml dans GED_MAIL_DOSSIER, jamais d'envoi).
GED_NOM=
GED_MAIL_TRANSPORT=
GED_MAIL_EXPEDITEUR=
GED_MAIL_EXPEDITEUR_NOM=
GED_MAIL_DOSSIER=var/mails
GED_SMTP_HOTE=
GED_SMTP_PORT=587
GED_SMTP_UTILISATEUR=
GED_SMTP_MOT_DE_PASSE=
GED_SMTP_CHIFFREMENT=tls
