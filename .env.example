# GEDv1 / K-Docs - variables d'environnement
# Copier vers .env et adapter (ne jamais committer .env)

APP_DEBUG=false
# Preferer 127.0.0.1 (IPv4) : le serveur PHP integre ecoute souvent en 127.0.0.1 uniquement
APP_URL=http://127.0.0.1:8765/kdocs
APP_TIMEZONE=Europe/Zurich

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kdocs
DB_USERNAME=root
DB_PASSWORD=

# IA (optionnel)
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# OnlyOffice (optionnel)
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=

# Connecteur WinBiz
WINBIZ_ENABLED=false

# App invoices
INVOICES_APP_ENABLED=false
WINBIZ_BRIDGE_URL=

# Plugins verticaux (scaffold)
SMQ_APP_ENABLED=false
RH_APP_ENABLED=false

# IA — taxonomie et intégrations
# Export HTMLEDITOR : _variables.json (variables, sets, sections/tags optionnels)
HTMLEDITOR_TAXONOMY_PATH=F:\DATA\DEVELOPPEMENT\htmleditor_v3\htmleditor\sources\_variables.json
CLEARMYDOCS_PATH=F:\DATA\DEVELOPPEMENT\clearmydocs-v3
CLEARMYDOCS_SIDECAR_URL=http://127.0.0.1:5101
CLEARMYDOCS_API_URL=http://127.0.0.1:8790
CLEARMYDOCS_ENABLED=false
CLEARMYDOCS_MIN_VERSION=3.0.0
CLEARMYDOCS_SIDECAR_TIMEOUT=120
# auto = sidecar CMD v3 OK -> couplé, sinon natif | coupled | native
INGEST_ENGINE=auto
IA_PDF_SPLIT_ENABLED=true
IA_UNIFIED_MIN_CONFIDENCE=0.75
IA_UNIFIED_CLASSIFY_ENABLED=true
INFOMANIAK_AI_ENABLED=false
INFOMANIAK_AI_API_KEY=
GEDV1_DEBUG_SESSION=
