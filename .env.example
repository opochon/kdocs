# GEDv1 / K-Docs — variables d'environnement
# Copier vers .env et adapter (ne jamais committer .env)

APP_DEBUG=false
APP_URL=http://localhost/gedv1
APP_TIMEZONE=Europe/Zurich

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kdocs
DB_USERNAME=root
DB_PASSWORD=

# IA (optionnel)
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# OnlyOffice (optionnel)
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=

# Connecteur WinBiz
WINBIZ_ENABLED=false

# App invoices
INVOICES_APP_ENABLED=false
