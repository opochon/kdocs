# GEDv1 / K-Docs - variables d'environnement
# Copier vers .env et adapter (ne jamais committer .env)

APP_DEBUG=false
# Preferer 127.0.0.1 (IPv4) : le serveur PHP integre ecoute souvent en 127.0.0.1 uniquement
APP_URL=http://127.0.0.1:8765/kdocs
APP_TIMEZONE=Europe/Zurich

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kdocs
DB_USERNAME=root
DB_PASSWORD=

# IA (optionnel)
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# OnlyOffice (optionnel)
ONLYOFFICE_ENABLED=false
ONLYOFFICE_URL=http://localhost:8080
ONLYOFFICE_JWT_SECRET=

# --- Connecteurs (optionnels — la GED fonctionne sans) ---
# Voir docs/CONNECTEURS-PLUGINS.md

# ERP WinBiz (k-winbiz-bridge, dépôt WinbizIntegrator)
WINBIZ_ENABLED=false
WINBIZ_BRIDGE_URL=http://127.0.0.1:5100

# Ingest CMD v4 (cible factures — optionnel, dépôt clearmydocs-v3/cmdv4)
# API : clearmydocs-v3/cmdv4/docs/API.md (défaut port 8510, env CLEARMYDOCS_PORT)
CMD_V4_ENABLED=false
CMD_V4_URL=http://127.0.0.1:8510
CMD_V4_PATH=F:\DATA\DEVELOPPEMENT\clearmydocs-v3
CMD_V4_INVOICE_ENABLED=true
CMD_V4_INVOICE_STRICT=false
CMD_V4_PROJECT_PROFILE=legal_ch
CMD_V4_JOB_TIMEOUT=300
CMD_V4_KEEP_STAGING=false

# Plugins métier (apps/ — routes si enabled + connecteur requis OK)
INVOICES_APP_ENABLED=false
SMQ_APP_ENABLED=false
RH_APP_ENABLED=false
MAIL_APP_ENABLED=false
CONTRACTS_APP_ENABLED=false
PORTAL_APP_ENABLED=false

# K-ERP Connect (plugin liaison ERP K-Time — spec K-TIME/docs/SPEC-GED-INTEGRATION.md)
# Nécessite CMD v4 (extraction champs facture) + K-Time accessible (KTIME_URL)
# Gate locale : run-erp-simulation.bat (K-Time sur 8091, clé ged-dev-key-2026)
ERPCONNECT_APP_ENABLED=false
KTIME_URL=http://127.0.0.1:8091
KTIME_GED_API_KEY=

# Conformité / sécurité (sprint parité 90 %)
# GAP-041 : isolation multi-mandant (nécessite migration add_tenant_columns.php)
MULTI_TENANT_ENABLED=false
# GAP-023 : horodatage qualifié RFC 3161 (URL du fournisseur TSA)
TSA_URL=
# GAP-045 : antivirus upload via clamd (INSTREAM)
CLAMAV_ENABLED=false
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310

# Taxonomie HTMLEDITOR (optionnel — classification)
HTMLEDITOR_TAXONOMY_PATH=F:\DATA\DEVELOPPEMENT\htmleditor_v3\htmleditor\sources\_variables.json
IA_PDF_SPLIT_ENABLED=true
IA_UNIFIED_MIN_CONFIDENCE=0.75
IA_UNIFIED_CLASSIFY_ENABLED=true
# Infomaniak AI Tools (remplace Claude si activé — cloud suisse)
INFOMANIAK_AI_ENABLED=false
INFOMANIAK_AI_API_KEY=
INFOMANIAK_AI_API_SECRET=
# product_id AI Tools (alias INFOMANIAK_AI_PRODUCT_ID / INFOMANIAK_PRODUCT_ID)
INFOMANIAK_AI_MODEL=swiss-ai/Apertus-70B-Instruct-2509
INFOMANIAK_AI_TIMEOUT=120
GEDV1_DEBUG_SESSION=
