# Dependencies
/vendor/
/node_modules/
composer.phar

# Tailwind CLI (download with build-tailwind.bat)
tailwindcss.exe
tailwindcss-windows-x64.exe

# Reference de fonctions (artéfact régénérable)
/docs/api-ref/

# Configuration locale
/config/config.local.php
/config/config.php
*.env
.env.local

# Logs
*.log
/logs/
/storage/logs/
.cursor/debug.log

# Cache
/cache/
/storage/cache/
/storage/temp/

# Backups
/storage/backups/

# Uploads temporaires
/storage/uploads/temp/

# Storage runtime (données utilisateur — jamais versionner)
/storage/documents/**
/storage/consume/**
/storage/processed/**
/storage/crawl_queue/**
/storage/ratelimit/**
/storage/trash/**
/storage/*.json
/storage/*.pid
/storage/*.lock
/storage/crawler_last_run.txt
/storage/.indexing_*.json
/storage/training.json
!/storage/.htaccess

# Racine storage alternative (config/config.php storage.base_path — meme categorie
# donnees utilisateur que /storage/documents ci-dessus, jamais versionner). Constat
# 2026-08-28 : `git add -n` la proposait reellement au staging — dossiers/fichiers
# reels de tiers (factures, courriers, dossier judiciaire) a un `git add -A` de la sortie.
/storage/courrier-matin/**

# Reservations inter-sessions (tools/claim.mjs) — etat ephemere machine/session,
# jamais versionne.
/governance/claims/*.json

# Plans de session locaux (.zcode, outil tiers, meme categorie que .cursor/)
/.zcode/

# Cache PHPUnit
.phpunit.cache/

# Fichier parasite Windows
nul
**/nul

# Backups horodatés (code ou config)
*.backup_*
/config/*.bak
/config/*.backup_*

# Agents / IDE locaux
# .claude/ n est PAS exclu en bloc : git ne descend jamais dans un repertoire
# exclu, donc les re-inclusions !.claude/xxx/ plus bas ne fonctionnaient pas —
# .claude/commands/reprendre.md n etait suivi que parce qu il avait ete force.
# On exclut donc seulement ce qui est local a la machine.
.claude/settings.local.json
.claude/scheduled_tasks.lock
.cursor/

# Tests locaux / artefacts
/tests/debug/
/tests/test_results/
/tests/api_test.zip
/tests/screenshots/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Tests
/tests/_output/
/tests/output/
/tests/results/
/tests/samples/*.pdf
/tests/samples/*.docx
/tests/samples/*.msg
/tests/screenshots/current/
/tests/screenshots/diff/
/tests/screenshots/*.json
/tests/screenshots/*.html

# Documentation générée
/docs/_build/
/docs/SMOKE-FULL-REPORT.md

# Fichiers temporaires
*.tmp
*.bak
*.backup
cookies.txt

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
ENV/

# Thumbnails (générés automatiquement)
/storage/thumbnails/

# Fichiers de test temporaires
test_*.php
check_*.php
find_*.php
generate_*.php
create_*.php
install_*.ps1
install_*.md
STATUS_*.md
STATUT_*.md
RAPPORT_*.md
RESUME_*.md
COMPARAISON_*.md
ANALYSE_*.md
AMELIORATIONS_*.md
PLAN_*.md
IMPLEMENTATION_*.md
MANQUANT_*.md
SETUP_*.md
INSTALL_*.md
INSTALLATION*.md
GUIDE_*.md
WEBHOOKS_*.md
DEBUG_*.md

claude_api_key.txt

# Binaires (telecharger manuellement)
/bin/qdrant*
/bin/ollama*
/bin/*.exe

# Large installer files (> 100MB GitHub limit)
/installer/*.msi
/installer/*.exe
/installer/downloads/

# Apps storage
/storage/apps/

# Archive
/_archive/

# Connectors data
/connectors/*/data/
/connectors/*/*.cache

# Captures d audit visuel (artefacts, non versionnes)
tests/visual/audit/

# Artefacts bruts de run du harness (regeneres a chaque passage, non versionnes).
# playwright-latest.json serialise les en-tetes des requetes API, dont X-Api-Key :
# il ne doit jamais entrer dans l historique. Voir item erp.cle-masquee.
tests/reports/playwright-latest.json
tests/reports/phpunit-junit.xml
tests/reports/checklist-latest.json

# Exception aux motifs test_*.php / tests-ignores ci-dessus : les sondes que le
# harness execute doivent etre versionnees. Une suite dont le fichier n'existe
# que sur une machine disparait au premier clone, sans que personne le voie.
!tests/integration/
!tests/integration/test_*.php
