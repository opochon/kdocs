<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Application de session (jamais un service) : Office n'est piloté que dans la session de
         l'utilisateur. WinExe : aucune fenêtre de console quand Windows réveille l'agent par kdocs://. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Kdocs.AgentPoste</RootNamespace>
    <AssemblyName>Kdocs.AgentPoste</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- Open XML SDK : conversion du paquet Flat OPC de Word en .docx, sans toucher au document. -->
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <!-- DPAPI (ProtectedData) : fourni par net10.0-windows ; le jeton n'est lisible que par
         l'utilisateur Windows enrôlé. Aucun paquet séparé n'est nécessaire. -->
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kdocs.AgentPoste.Tests" />
  </ItemGroup>

</Project>
