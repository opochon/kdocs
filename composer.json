{
    "name": "kdocs/kdocs",
    "description": "K-Docs - Gestion Électronique de Documents",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "ext-fileinfo": "*",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.0",
        "php-di/php-di": "^7.0",
        "monolog/monolog": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "friendsofphp/php-cs-fixer": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "KDocs\\": "app/",
            "KDocs\\Apps\\": "apps/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "KDocs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "php tests/run_all.php",
        "test:smoke": "php tests/smoke_test.php",
        "test:api": "php tests/api_test.php",
        "test:integration": "php tests/integration_test.php",
        "test:ui": "php tests/ui_test.php",
        "test:migration": "php tests/migration_smoke_test.php",
        "test:unit": "phpunit --testsuite=unit",
        "test:coverage": "phpunit --coverage-html tests/output/coverage",
        "check": [
            "@test:smoke",
            "@phpstan",
            "@cs-check"
        ],
        "phpstan": "phpstan analyse -c phpstan.neon --memory-limit=512M",
        "cs-check": "phpcs --standard=PSR12 app/ --ignore=*/vendor/*",
        "cs-fix": "php-cs-fixer fix app/",
        "pre-commit": "sh .git/hooks/pre-commit",
        "install-hooks": "cp .git/hooks/pre-commit.sample .git/hooks/pre-commit 2>/dev/null; cp tools/pre-commit .git/hooks/pre-commit"
    },
    "scripts-descriptions": {
        "test": "Run all tests",
        "test:smoke": "Quick health checks",
        "test:api": "Test REST API endpoints",
        "test:integration": "Full integration tests",
        "check": "Pre-commit validation (smoke + phpstan + cs)",
        "phpstan": "Static analysis",
        "cs-check": "Check coding standards",
        "cs-fix": "Fix coding standards"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
