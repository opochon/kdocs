{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% import 'partiels/papier.twig' as papier %}
{% import 'partiels/visionneuse.twig' as visionneuse %}
{% block titre %}À traiter{% endblock %}
{% block contenu %}
<div class="page pleine" data-testid="ecran-a-traiter">
  <div class="page-tete">
    <div class="titre"><h1>À traiter</h1><span class="muted" data-testid="titre-a-traiter-compte">{{ file|length }} document{{ file|length > 1 ? 's' }} attend{{ file|length > 1 ? 'ent' : '' }} votre contrôle</span></div>
    <div class="actions">
      <a class="btn primaire" href="/deposer" data-testid="action-deposer">{{ ic.i('plus') }}Déposer des documents</a>
    </div>
  </div>

  {# Bilan d'ingestion : jamais le dossier, seulement ce qui s'est passé. Masqué sur téléphone (bruit). #}
  <section class="bilan" data-testid="bilan-ingestion" aria-label="Bilan d’ingestion">
    <div class="carte kpi ok" data-testid="bilan-auto"><span class="pastille">{{ ic.i('check') }}</span>
      <div><div class="valeur">{{ bilan.auto }}</div><div class="libelle">Classés automatiquement</div><div class="detail">fiabilité ≥ {{ bilan.seuil }} %, rangés sans intervention</div></div></div>
    <div class="carte kpi warn" data-testid="bilan-a-controler"><span class="pastille">{{ ic.i('alerte') }}</span>
      <div><div class="valeur">{{ bilan.a_controler }}</div><div class="libelle">À contrôler</div><div class="detail">proposition sous le seuil ou sans preuve</div></div></div>
    <div class="carte kpi info" data-testid="bilan-en-cours"><span class="pastille">{{ ic.i('horloge') }}</span>
      <div><div class="valeur">{{ bilan.en_cours }}</div><div class="libelle">En cours de lecture</div><div class="detail">découpe et classement en arrière-plan · {{ bilan.lots }} lot{{ bilan.lots > 1 ? 's' : '' }} scanné{{ bilan.lots > 1 ? 's' : '' }}</div></div></div>
  </section>

  {# Ordinateur : file à gauche, aperçu, proposition. Téléphone : aperçu en haut, proposition dessous,
     file en dernier, repliée en simple compteur (la mise en ordre est dans le CSS, point de rupture). #}
  <div class="volets traiter">
    <details class="carte volet volet-file" data-testid="bloc-file" open>
      <summary class="volet-tete" data-testid="file-repli">File <span class="muted">· {{ file|length }} à contrôler</span> <span class="muted">· du plus ancien au plus récent</span></summary>
      <ul class="liste volet-corps" data-testid="file-a-traiter">
        {% for p in file %}
        <li><a href="/a-traiter?doc={{ p.id }}" data-testid="file-item-{{ p.id }}" {% if p.id == courant.id %}aria-current="true"{% endif %}>
          <span class="l1"><span>{{ p.titre }}</span></span>
          <span class="l2"><span>{{ p.emetteur }}</span></span>
          <span class="l2">{% if p.source %}<span class="source {{ p.source }}">{{ p.source }}</span>{% endif %}{{ p.type }}{% if p.confiance is not null %}
            <span class="jauge {{ p.confiance >= bilan.seuil ? 'haute' }}"><b style="width: {{ p.confiance }}%"></b></span>{{ p.confiance }} %{% endif %}</span>
        </a></li>
        {% endfor %}
      </ul>
    </details>

    <section class="carte volet volet-apercu" aria-label="Aperçu">
      <div class="volet-tete">
        <span data-testid="apercu-pages">{{ courant.pages }} page{{ courant.pages > 1 ? 's' : '' }}</span>
      </div>
      {# Le vrai document remplace la page de papier dès qu'un fichier existe (macro du secteur Aperçu). #}
      {% if courant.rendu %}
        {{ visionneuse.moteur(courant.rendu, 'apercu', {
          id: courant.id, csrf: csrf, fusion: fusion
        }) }}
      {% else %}
        <div class="visionneuse" data-testid="apercu">{{ papier.page(courant.texte, 'apercu-page') }}</div>
      {% endif %}
    </section>

    <section class="carte volet volet-proposition" aria-label="Classement proposé">
      <form class="volet-corps" data-testid="formulaire-validation" method="post"
            action="{{ courant.id > 0 ? '/a-traiter/' ~ courant.id ~ '/valider' : '' }}" data-doc="{{ courant.id }}">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <div class="volet-tete">Classement proposé</div>
        <div class="raison" data-testid="raison-controle">{{ ic.i('alerte') }}<span>À contrôler : {{ courant.raison }}.</span></div>
        <div class="champ"><label for="f-type">Type {% if courant.source %}<span class="source {{ courant.source }}">{{ courant.source }}{% if courant.confiance is not null %} · {{ courant.confiance }} %{% endif %}</span>{% endif %}</label>
          <select id="f-type" name="type" data-testid="champ-type" required>
            <option value="" {% if courant.type == '' %}selected{% endif %}>— choisir un type —</option>
            {% for t in types %}<option value="{{ t }}" {% if t == courant.type %}selected{% endif %}>{{ t }}</option>{% endfor %}
          </select></div>
        <div class="champ"><label for="f-emetteur">Émetteur {% if courant.emetteur %}<span class="source IA">lu dans l’en-tête</span>{% endif %}</label>
          <input id="f-emetteur" name="emetteur" value="{{ courant.emetteur }}" data-testid="champ-emetteur"></div>
        <div class="champ"><label for="f-titre">Titre</label><input id="f-titre" name="titre" value="{{ courant.titre }}" data-testid="champ-titre"></div>
        <div class="champ"><label for="f-date">Date du document</label><input id="f-date" name="date" type="date" value="{{ courant.date }}" data-testid="champ-date"></div>
        <div class="champ"><label for="f-montant">Montant (CHF)</label><input id="f-montant" name="montant" inputmode="decimal" value="{{ courant.montant is null ? '' : courant.montant|number_format(2, '.', '\'') }}" data-testid="champ-montant"></div>
        <div class="champ"><label>Étiquettes</label><div class="filtres">{% for e in courant.etiquettes %}<span class="chip">{{ e }}</span>{% endfor %}</div>
          <input type="hidden" name="etiquettes" value="{{ courant.etiquettes|join(', ') }}"></div>
        <div class="champ"><label>Rangé dans</label><span class="mono" data-testid="chemin-rangement">{{ courant.date|slice(0, 4) }}/{{ courant.type ? courant.type|replace({' ': '_'}) : 'À_classer' }}/{{ courant.emetteur|replace({' ': '_'}) }}/</span></div>
      </form>
      <div class="pied-validation">
        {# V2-10c : au pouce, on ne valide pas à l'aveugle — la proposition tient en une ligne AU-DESSUS
           des trois gestes (type · émetteur · date, et le motif de contrôle). Masqué sur ordinateur où le
           formulaire complet est visible. #}
        <div class="resume-proposition" data-testid="resume-proposition">
          <strong>{{ courant.type ?: 'sans type' }}</strong>
          {% if courant.emetteur %}<span class="emetteur">{{ courant.emetteur }}</span>{% endif %}
          {% if courant.date %}<span>{{ courant.date|date('d.m.Y') }}</span>{% endif %}
          {% if courant.raison %}<span class="motif">à contrôler · {{ courant.raison }}</span>{% endif %}
        </div>
        <button class="btn primaire" type="button" data-action="valider" data-testid="action-valider">{{ ic.i('check') }}Valider<span class="kbd">Entrée</span></button>
        <button class="btn" type="button" data-action="corriger" data-testid="action-corriger">{{ ic.i('alerte') }}Corriger</button>
        <button class="btn" type="button" data-action="suivant" data-testid="action-passer">Passer<span class="kbd">→</span></button>
      </div>
    </section>

    {# Téléphone (V2-10b) : le bilan d'ingestion devient UNE ligne compacte, placée APRÈS la pièce
       courante — la pièce reste d'abord. Les trois cartes ne s'affichent que sur ordinateur. #}
    <p class="bilan-ligne" data-testid="bilan-ligne">
      {{ bilan.a_controler }} à contrôler · {{ bilan.auto }} classés seuls{% if bilan.en_cours > 0 %} · {{ bilan.en_cours }} en lecture{% endif %}
    </p>
  </div>
</div>
{% endblock %}
