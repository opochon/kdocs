{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% set libelle = application == 'cmm' ? 'ClearMyMails' : (application != '' ? application : 'une application') %}
{% block titre %}Relier {{ libelle }}{% endblock %}
{% block contenu %}
<div class="page" data-testid="ecran-appairage">
  <div class="page-tete">
    <div class="titre">
      <h1>Relier {{ libelle }}</h1>
      <span class="muted">application tierce — dépôt de documents en votre nom</span>
    </div>
  </div>

  {% if erreur %}
    <section class="carte" data-testid="appairage-erreur" style="margin-bottom:12px">
      <h2>Demande refusée</h2>
      <p><strong data-testid="appairage-erreur-etape">appairage</strong> · <span data-testid="appairage-erreur-cause">{{ erreur }}</span></p>
    </section>
  {% endif %}

  <section class="carte" data-testid="appairage-demande">
    <h2>{{ libelle }} demande à déposer des documents en votre nom</h2>
    <div class="ligne-reglage"><span>Application</span><span class="mono" data-testid="appairage-application">{{ libelle }}</span></div>
    <div class="ligne-reglage"><span>Poste</span><span class="mono" data-testid="appairage-poste">{{ appareil != '' ? appareil : 'poste inconnu' }}</span></div>
    <div class="ligne-reglage"><span>Portée</span><span><span class="chip">dépôt</span> <span class="muted">les droits sont décidés par la GED, dossier par dossier</span></span></div>
    <p class="muted">En acceptant, {{ libelle }} recevra un jeton lié à votre compte, révocable à tout moment depuis Application › Appareils reliés.</p>
    {% if not erreur %}
      <form method="post" action="/appairage" class="actions">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <input type="hidden" name="application" value="{{ application }}">
        <input type="hidden" name="nom" value="{{ appareil }}">
        <input type="hidden" name="retour" value="{{ retour }}">
        <input type="hidden" name="etat" value="{{ etat }}">
        <button class="btn primaire" type="submit" data-testid="action-appairage-accepter">Accepter la liaison</button>
        <a class="btn discret" href="{{ retour }}{{ retour|split('?')|length > 1 ? '&' : '?' }}etat={{ etat|url_encode }}&refus=1" data-testid="action-appairage-refuser">Refuser</a>
      </form>
    {% endif %}
  </section>
</div>
{% endblock %}
