{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% block titre %}Appareils reliés{% endblock %}
{% block contenu %}
<div class="page" data-testid="ecran-appareils">
  <div class="page-tete">
    <div class="titre">
      <h1>Application › Appareils reliés</h1>
      <span class="muted">applications tierces autorisées à déposer en votre nom — {{ compte }}</span>
    </div>
  </div>

  <div class="actions" style="margin-bottom:12px">
    <a class="btn discret" href="/application" data-testid="appareils-retour">{{ ic.i('fleche') }}Application</a>
  </div>

  {% if appareils is empty %}
    <section class="carte" data-testid="appareils-vide"><p class="muted">Aucune application reliée. La liaison se fait depuis l’application (ClearMyMails, Réglages › GED).</p></section>
  {% else %}
    <div style="display:grid;gap:12px">
      {% for a in appareils %}
        <section class="carte" data-testid="appareil">
          <div class="ligne-reglage">
            <span><strong>{{ a.application == 'cmm' ? 'ClearMyMails' : a.application }}</strong> · <span class="mono">{{ a.appareil }}</span></span>
            <span>
              {% if a.actif %}<span class="chip ok">actif</span>{% else %}<span class="chip">révoqué</span>{% endif %}
            </span>
          </div>
          <div class="ligne-reglage"><span>Portée</span><span class="mono">dépôt</span></div>
          <div class="ligne-reglage"><span>Relié le</span><span class="mono">{{ a.cree_le }}</span></div>
          <div class="ligne-reglage"><span>Dernier usage</span><span class="mono">{{ a.derniere_utilisation ?: 'jamais' }}</span></div>
          {% if a.actif %}
            <form method="post" action="/application/appareils/{{ a.id }}/revoquer" class="actions">
              <input type="hidden" name="csrf" value="{{ csrf }}">
              <button class="btn" type="submit" data-testid="action-revoquer-appareil">Révoquer</button>
            </form>
          {% endif %}
        </section>
      {% endfor %}
    </div>
  {% endif %}
</div>
{% endblock %}
