{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% block titre %}Application{% endblock %}
{% block contenu %}
<div class="page" data-testid="ecran-application">
  <div class="page-tete">
    <div class="titre"><h1>Application</h1><span class="muted">réglages de l’installation — les référentiels métier sont dans Administration</span></div>
  </div>
  <div class="reglages">
    <nav class="carte" aria-label="Sections"><ul class="arbre">
      {% for s in ['Ingestion', 'Stockage', 'Intelligence artificielle', 'Connecteurs', 'Utilisateurs et droits', 'Administration'] %}
        <li><a href="#s-{{ loop.index }}" data-testid="section-{{ loop.index }}">{{ s }}</a></li>
      {% endfor %}
    </ul></nav>
    <div style="display:grid;gap:12px">
      <section class="carte section-reglage" id="s-1" data-testid="reglage-ingestion"><h2>Ingestion</h2>
        <div class="ligne-reglage"><span>Dossier d’ingestion</span><span data-testid="reglage-dossier-ingestion">
          {% if ingestion.dossier_configure %}<span class="chip ok">configuré</span>{% else %}<span class="chip warn">non configuré</span>{% endif %}
          <span class="muted">· le chemin n’est jamais montré aux utilisateurs</span></span></div>
        <div class="ligne-reglage"><span>Adresse d’ingestion</span><span data-testid="reglage-adresse-ingestion">
          {% if ingestion.adresse_configuree %}<span class="mono">{{ ingestion.adresse }}</span> <span class="muted">· boîte IMAP des pièces entrantes, relevée par la tâche d’ingestion</span>
          {% else %}<span class="chip warn">non configuré</span> <span class="muted">· aucune boîte IMAP relevée</span>{% endif %}
        </span></div>
        <div class="ligne-reglage"><span>Agent d’ingestion</span><span data-testid="reglage-derniere-tache">
          {% if ingestion.derniere_tache %}
            <span class="chip ok">{{ ingestion.derniere_tache.etat }}</span>
            <span class="mono">{{ ingestion.derniere_tache.nom }}</span>
            <span class="muted">· source {{ ingestion.derniere_tache.source }}, dernière activité {{ ingestion.derniere_tache.affichage }} ({{ ingestion.derniere_tache.il_y_a }})</span>
          {% else %}<span class="chip warn">aucune tâche</span> <span class="muted">· aucune ingestion enregistrée pour cette installation</span>{% endif %}
        </span></div>
        <div class="ligne-reglage"><span>Retouche de pages PDF</span><span data-testid="reglage-editeur-pdf">
          {% if edition_pdf.disponible %}<span class="chip ok">disponible</span> <span class="muted">· {{ edition_pdf.moteur }}</span>
          {% else %}<span class="chip warn">indisponible</span> <span class="muted">· {{ edition_pdf.message }}</span>{% endif %}
        </span></div>
        <div class="ligne-reglage"><span>Seuil de classement automatique</span><span><strong data-testid="reglage-seuil">{{ ia.seuil }} %</strong> <span class="muted">et un indice du type dans le texte, ou une habitude</span></span></div>
        <div class="ligne-reglage"><span>Habitude formée après</span><span>
          {% if ia.habitude is not null %}<strong data-testid="reglage-habitude">{{ ia.habitude }}</strong> choix identiques{% else %}<span class="muted" data-testid="reglage-habitude">non configuré</span>{% endif %}
          pour un même émetteur</span></div>
      </section>
      <section class="carte section-reglage" id="s-2" data-testid="reglage-stockage"><h2>Stockage</h2>
        <div class="ligne-reglage"><span>Racine documentaire</span><span class="mono" data-testid="reglage-racine">{{ stockage.racine }} — le dossier fait foi</span></div>
        <div class="ligne-reglage"><span>Rangement</span><span class="mono" data-testid="reglage-rangement">{{ stockage.rangement }} <span class="muted">· sans type : {{ stockage.sans_type }}</span></span></div>
        <div class="ligne-reglage" data-testid="reconstruction-index"><span>Reconstruire l’index depuis le dossier</span><span>
          {% if reconstruction and reconstruction.etat == 'en_cours' %}
            <progress data-testid="reconstruction-barre" value="{{ reconstruction.traite }}" max="{{ reconstruction.total > 0 ? reconstruction.total : 1 }}" style="width:180px;height:8px;vertical-align:middle"></progress>
            <strong data-testid="reconstruction-progression">{{ reconstruction.traite }} / {{ reconstruction.total }}</strong>
            <strong data-testid="reconstruction-pourcentage">{{ reconstruction.total > 0 ? (reconstruction.traite * 100 // reconstruction.total) : 0 }} %</strong> <span class="muted">· reprise possible après une coupure</span>
            <form method="post" action="/application/reconstruction-index/{{ reconstruction.id }}/tranche" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn discret" type="submit" data-testid="reconstruction-tranche">Traiter la tranche suivante</button></form>
          {% elseif reconstruction and reconstruction.etat == 'termine' %}
            <progress data-testid="reconstruction-barre" value="{{ reconstruction.total > 0 ? reconstruction.total : 1 }}" max="{{ reconstruction.total > 0 ? reconstruction.total : 1 }}" style="width:180px;height:8px;vertical-align:middle"></progress>
            <span class="chip ok" data-testid="reconstruction-terminee">terminée</span>
            <strong data-testid="reconstruction-progression">{{ reconstruction.traite }} / {{ reconstruction.total }}</strong>
            <strong data-testid="reconstruction-pourcentage">100 %</strong> <span class="muted">{{ reconstruction.traite }} documents indexés</span>
            <form method="post" action="/application/reconstruction-index" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn discret" type="submit" data-testid="reconstruction-lancer">Relancer</button></form>
          {% else %}
            <form method="post" action="/application/reconstruction-index" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn" type="submit" data-testid="reconstruction-lancer">Lancer la reconstruction</button></form>
            {% if reconstruction and reconstruction.erreur %}<span class="muted">Échec : {{ reconstruction.erreur }}</span>{% endif %}
          {% endif %}
          {# Le bilan nomme les documents vivants absents du fonds : jamais fondus dans le pourcentage. #}
          {% if reconstruction and reconstruction.absents > 0 %}
            <span data-testid="reconstruction-absents">
              <span class="chip warn">{{ reconstruction.absents }} document(s) vivant(s) absent(s) du fonds</span>
              <span class="mono">{{ reconstruction.absents_noms|join(', ') }}{% if reconstruction.absents > reconstruction.absents_noms|length %} …{% endif %}</span>
              <span class="muted">· non relus : leurs fichiers ne sont pas dans ce fonds</span>
            </span>
          {% endif %}
          {# Le bilan nomme aussi les documents du périmètre disparus EN COURS de reconstruction (ecart). #}
          {% if reconstruction and reconstruction.ecart > 0 %}
            <span data-testid="reconstruction-ecart">
              <span class="chip warn">{{ reconstruction.ecart }} document(s) du périmètre disparu(s) pendant la reconstruction</span>
              <span class="muted">· annoncés au lancement, retirés du fonds en cours de route : non relus</span>
            </span>
          {% endif %}
        </span></div>
        <div class="ligne-reglage" data-testid="pdfa-rattrapage"><span>Copies d’archivage PDF/A-2b</span><span>
          {% if pdfa and pdfa.etat == 'en_cours' %}
            <progress data-testid="pdfa-barre" value="{{ pdfa.traite }}" max="{{ pdfa.total > 0 ? pdfa.total : 1 }}" style="width:180px;height:8px;vertical-align:middle"></progress>
            <strong data-testid="pdfa-progression">{{ pdfa.traite }} / {{ pdfa.total }}</strong>
            <span class="muted">· reprise possible après une coupure</span>
            <form method="post" action="/application/pdfa-rattrapage/{{ pdfa.id }}/tranche" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn discret" type="submit" data-testid="pdfa-tranche">Traiter la tranche suivante</button></form>
          {% elseif pdfa and pdfa.etat == 'termine' %}
            <progress data-testid="pdfa-barre" value="{{ pdfa.total > 0 ? pdfa.total : 1 }}" max="{{ pdfa.total > 0 ? pdfa.total : 1 }}" style="width:180px;height:8px;vertical-align:middle"></progress>
            <span class="chip ok" data-testid="pdfa-terminee">terminée</span>
            <strong data-testid="pdfa-progression">{{ pdfa.traite }} / {{ pdfa.total }}</strong> <span class="muted">· documents parcourus</span>
            <form method="post" action="/application/pdfa-rattrapage" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn discret" type="submit" data-testid="pdfa-lancer">Relancer</button></form>
          {% else %}
            <form method="post" action="/application/pdfa-rattrapage" class="inline"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn" type="submit" data-testid="pdfa-lancer">Lancer le rattrapage</button></form>
            {% if pdfa and pdfa.erreur %}<span class="muted">Échec : {{ pdfa.erreur }}</span>{% endif %}
          {% endif %}
          {% if pdfa and pdfa.ecart > 0 %}
            <span data-testid="pdfa-ecart"><span class="chip warn">{{ pdfa.ecart }} document(s) disparu(s) pendant le rattrapage</span></span>
          {% endif %}
          {% if pdfa and pdfa.reprises > 0 %}
            <span data-testid="pdfa-reprises"><span class="chip ok">{{ pdfa.reprises }} copie(s) reprise(s) sans toucher aux originaux</span></span>
          {% endif %}
        </span></div>
      </section>
      <section class="carte section-reglage" id="s-3" data-testid="reglage-ia"><h2>Intelligence artificielle</h2>
        <div class="ligne-reglage"><span>Fournisseur</span><span>{{ ia.fournisseur }}
          {% if ia.actif %}<span class="chip ok">actif</span>{% else %}<span class="chip warn">non activé</span>{% endif %}</span></div>
        <div class="ligne-reglage"><span>Modèle de classement</span><span class="mono" data-testid="reglage-modele-ia">{{ ia.modele }} <span class="muted">· délai {{ ia.delai }} s + 1 reprise</span></span></div>
      </section>
      <section class="carte section-reglage" id="s-4" data-testid="reglage-connecteurs"><h2>Connecteurs</h2>
        <div class="ligne-reglage"><span>K-Time</span><span data-testid="etat-ktime">
          {% if connecteurs.ktime.relie %}<span class="chip ok">relié</span> <span class="muted">· {{ connecteurs.ktime.appareils }} appairage{{ connecteurs.ktime.appareils > 1 ? 's' : '' }} actif{{ connecteurs.ktime.appareils > 1 ? 's' : '' }}</span>
          {% else %}<span class="chip">non relié</span> <span class="muted">· aucune liaison K-Time configurée</span>{% endif %}
        </span></div>
        <div class="ligne-reglage"><span>ClearMyMails</span><span data-testid="etat-cmm">
          {% if connecteurs.cmm.relie %}<span class="chip ok">relié</span> <span class="muted">· {{ connecteurs.cmm.appareils }} appareil{{ connecteurs.cmm.appareils > 1 ? 's' : '' }} appairé{{ connecteurs.cmm.appareils > 1 ? 's' : '' }} · classer depuis Gmail, Microsoft 365…</span>
          {% else %}<span class="chip">non relié</span> <span class="muted">· classer depuis Gmail, Microsoft 365…</span>{% endif %}
        </span></div>
        {# Lien ajusté par le secteur Jonctions (V2-08c) : la liaison part de Mon profil. #}
        <div class="ligne-reglage"><span>Mon profil · appareils reliés</span><span><a class="btn discret" href="/profil" data-testid="lien-appareils">Mon profil et appareils reliés</a></span></div>
        {# Ajout minimal du lot ged-parite-modele-2 (secteur Ingestion) : accès à l'administration du courrier. #}
        <div class="ligne-reglage"><span>Courrier · comptes et règles de tri</span><span><a class="btn discret" href="/courrier" data-testid="lien-courrier">Administration du courrier</a></span></div>
      </section>
    </div>
  </div>
</div>
{% endblock %}
