{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% import 'partiels/visionneuse.twig' as visionneuse %}
{% block titre %}Bibliothèque{% endblock %}
{% block contenu %}
<div class="page pleine" data-testid="ecran-bibliotheque">
  <div class="page-tete">
    <div class="titre">
      <h1>Bibliothèque</h1>
      <span class="muted" data-testid="compte-documents">{{ compte }} document{{ compte > 1 ? 's' }} affiché{{ compte > 1 ? 's' }} · {{ total }} dans le fonds</span>
    </div>
    <div class="actions">
      <a class="btn primaire" href="/a-traiter" data-testid="action-deposer">{{ ic.i('plus') }}Déposer</a>
      <details class="filtres" data-testid="bloc-filtres">
        <summary class="filtres" style="list-style:none;cursor:pointer" data-testid="filtres">
          <span class="chip" data-testid="filtre-type">Type : {{ filtres.type ?? 'tous' }}</span>
          <span class="chip" data-testid="filtre-emetteur">Émetteur : {{ filtres.emetteur ?? 'tous' }}</span>
          <span class="chip" data-testid="filtre-periode">Période : {{ filtres.de ?? '…' }} → {{ filtres.a ?? '…' }}</span>
          <span class="chip" data-testid="filtre-etiquette">{% if filtres.etiquettes %}Étiquette : {{ filtres.etiquettes|join(', ') }}{% else %}Étiquette{% endif %}</span>
          {% if vueActive %}<span class="chip" data-testid="filtre-vue">Vue : {{ vueActive.nom }}</span>{% endif %}
        </summary>
        <form class="panneau" method="get" action="/bibliotheque" data-testid="formulaire-filtres">
          <div class="champ"><label for="f-type">Type</label>
            <select id="f-type" name="type" data-testid="filtre-type-select">
              <option value="">Tous les types</option>
              {% for t in types %}<option value="{{ t }}" {% if filtres.type == t %}selected{% endif %}>{{ t }}</option>{% endfor %}
            </select></div>
          <div class="champ"><label for="f-emetteur">Émetteur</label>
            <input id="f-emetteur" name="emetteur" value="{{ filtres.emetteur ?? '' }}" placeholder="Nom exact"></div>
          <div class="champ"><label for="f-de">Du</label>
            <input id="f-de" type="date" name="de" value="{{ filtres.de ?? '' }}"></div>
          <div class="champ"><label for="f-a">Au</label>
            <input id="f-a" type="date" name="a" value="{{ filtres.a ?? '' }}"></div>
          <div class="champ"><label for="f-etiquette">Étiquette</label>
            <input id="f-etiquette" name="etiquette" value="{{ filtres.etiquettes|join(', ') }}"></div>
          <div class="champ"><label for="f-champ">Champ personnalisé</label>
            <select id="f-champ" name="champ_cle" data-testid="filtre-champ-cle">
              <option value="">Aucun</option>
              {% for c in tousChamps %}<option value="{{ c.cle }}" {% if filtres.champ and filtres.champ.cle == c.cle %}selected{% endif %}>{{ c.nom }}</option>{% endfor %}
            </select></div>
          <div class="champ"><label for="f-op">Opérateur</label>
            <select id="f-op" name="champ_op" data-testid="filtre-champ-op">
              {% for nature, ops in operateurs %}
              <optgroup label="{{ nature }}">
                {% for o in ops %}<option value="{{ o.v }}" {% if filtres.champ and filtres.champ.op == o.v %}selected{% endif %}>{{ o.l }}</option>{% endfor %}
              </optgroup>
              {% endfor %}
            </select></div>
          <div class="champ"><label for="f-valeur">Valeur</label>
            <input id="f-valeur" name="champ_valeur" data-testid="filtre-champ-valeur" value="{{ filtres.champ ? filtres.champ.valeur : '' }}" placeholder="p. ex. 90"></div>
          <button class="btn primaire" type="submit" data-testid="action-appliquer-filtres">Appliquer</button>
          {% if filtres.type or filtres.emetteur or filtres.de or filtres.a or filtres.etiquettes or filtres.champ %}
          <a class="btn discret" href="/bibliotheque" data-testid="action-retirer-filtres">Retirer les filtres</a>
          {% endif %}
        </form>
      </details>
      <details data-testid="bloc-nouvelle-vue">
        <summary class="btn discret" style="list-style:none;cursor:pointer" data-testid="action-enregistrer-vue">Enregistrer cette vue</summary>
        <form class="panneau" method="post" action="/bibliotheque/vue" data-testid="formulaire-nouvelle-vue">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <input type="hidden" name="type" value="{{ filtres.type ?? '' }}">
          <input type="hidden" name="emetteur" value="{{ filtres.emetteur ?? '' }}">
          <input type="hidden" name="de" value="{{ filtres.de ?? '' }}">
          <input type="hidden" name="a" value="{{ filtres.a ?? '' }}">
          <input type="hidden" name="etiquette" value="{{ filtres.etiquettes|join(', ') }}">
          <input type="hidden" name="champ_cle" value="{{ filtres.champ ? filtres.champ.cle : '' }}">
          <input type="hidden" name="champ_op" value="{{ filtres.champ ? filtres.champ.op : '' }}">
          <input type="hidden" name="champ_valeur" value="{{ filtres.champ ? filtres.champ.valeur : '' }}">
          <div class="champ"><label for="nom-vue">Nom de la vue</label>
            <input id="nom-vue" name="nom" data-testid="nom-nouvelle-vue" placeholder="p. ex. Contrats à échéance < 90 j"></div>
          <button class="btn primaire" type="submit" data-testid="action-creer-vue">Créer la vue</button>
          <p class="muted">Une vue est un filtre enregistré : aucun document n’est déplacé.</p>
        </form>
      </details>
    </div>
  </div>

  {# Modification en masse (lot ged-parite-masse) : barre d'actions à GAUCHE sous le titre. Les cases de la
     liste sont rattachées à ce formulaire par `form="formulaire-masse"` (HTML5), ce qui évite d'imbriquer
     un formulaire dans le tableau et de dupliquer les filtres. #}
  <section class="carte barre-masse" data-testid="barre-masse" aria-label="Modification en masse">
    <form id="formulaire-masse" method="post" action="/bibliotheque/masse" data-testid="formulaire-masse">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      {# Filtres COURANTS : « tout le résultat filtré » est résolu côté serveur avec exactement ces filtres. #}
      <input type="hidden" name="vue" value="{{ vueActive ? vueActive.id : '' }}">
      <input type="hidden" name="dossier" value="{{ dossierActif ?? '' }}">
      <input type="hidden" name="type" value="{{ filtres.type ?? '' }}">
      <input type="hidden" name="emetteur" value="{{ filtres.emetteur ?? '' }}">
      <input type="hidden" name="de" value="{{ filtres.de ?? '' }}">
      <input type="hidden" name="a" value="{{ filtres.a ?? '' }}">
      <input type="hidden" name="etiquette" value="{{ filtres.etiquettes|join(', ') }}">
      <input type="hidden" name="champ_cle" value="{{ filtres.champ ? filtres.champ.cle : '' }}">
      <input type="hidden" name="champ_op" value="{{ filtres.champ ? filtres.champ.op : '' }}">
      <input type="hidden" name="champ_valeur" value="{{ filtres.champ ? filtres.champ.valeur : '' }}">
      <label class="coche"><input type="checkbox" data-testid="coche-tout-page"> <span>Toute la page</span></label>
      <label class="coche"><input type="checkbox" name="tout_resultat" value="1" data-testid="coche-tout-resultat"
        data-total="{{ totalFiltre }}"> <span>Tout le résultat filtré ({{ totalFiltre }})</span></label>
      <label class="champ-inline">Action
        <select name="action" data-testid="masse-action">
          <option value="type">Changer le type</option>
          <option value="etiquettes_ajouter">Ajouter des étiquettes</option>
          <option value="etiquettes_retirer">Retirer des étiquettes</option>
          <option value="emetteur">Changer l’émetteur</option>
          <option value="dossier">Déplacer vers un dossier</option>
          <option value="corbeille">Mettre en corbeille</option>
        </select>
      </label>
      <label class="champ-inline">Type cible
        <select name="masse_type" data-testid="masse-type">
          {% for t in types %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
        </select>
      </label>
      <label class="champ-inline">Étiquettes
        <input name="masse_etiquettes" data-testid="masse-etiquettes" placeholder="Urgent, 2026" size="14">
      </label>
      <label class="champ-inline">Émetteur
        <input name="masse_emetteur" data-testid="masse-emetteur" placeholder="Nom de l’émetteur" size="16">
      </label>
      <label class="champ-inline">Dossier
        <input name="masse_dossier" data-testid="masse-dossier" placeholder="Année/Type/Émetteur" size="18">
      </label>
      <button class="btn primaire" type="submit" data-testid="action-appliquer-masse">Appliquer</button>
      <p class="muted" data-testid="masse-confirmation" data-total="{{ totalFiltre }}">Sélectionnez des documents, puis une action : le nombre sera annoncé avant d’appliquer.</p>
    </form>
  </section>

  {% if masse %}
  <section class="carte" data-testid="masse-bilan" aria-label="Bilan de la modification en masse">
    <div class="volet-tete">Modification en masse — {{ masse.action }}
      <span class="chip {{ masse.etat == 'termine' ? 'ok' : 'warn' }}" data-testid="masse-etat">{{ masse.etat == 'termine' ? 'terminé' : masse.etat }}</span></div>
    <div class="panneau">
      <p data-testid="masse-bilan-chiffres">Traités : <strong>{{ masse.traites }}</strong> · Refusés : <strong>{{ masse.refuses|length }}</strong> · avancement {{ masse.traite }} / {{ masse.total }}</p>
      {% if masse.erreur %}<p class="raison" data-testid="masse-erreur">{{ masse.erreur }}</p>{% endif %}
      {% if masse.refuses %}
      <ul class="liste" data-testid="masse-refus">
        {% for refus in masse.refuses %}<li class="l2">document {{ refus.id }} — {{ refus.raison }}</li>{% endfor %}
      </ul>
      {% endif %}
      {% if masse.etat == 'en_cours' %}
      <form method="post" action="/bibliotheque/masse/{{ masse.id }}/tranche">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <button class="btn" type="submit" data-testid="masse-continuer">Poursuivre ({{ masse.traite }} / {{ masse.total }})</button>
      </form>
      {% else %}
      <p class="muted" data-testid="masse-termine">Aucun document n’est supprimé : une mise en corbeille reste réversible.</p>
      {% endif %}
    </div>
  </section>
  {% endif %}

  {% if erreur %}<p class="raison" data-testid="erreur-bibliotheque">{{ erreur }}</p>{% endif %}

  <div class="volets biblio">
    <aside class="carte volet" aria-label="Vues et dossiers">
      <div class="volet-corps">
        <div class="titre-section">Vues</div>
        <ul class="arbre" data-testid="vues">
          {% for v in vuesVolet %}
          <li><a href="{{ v.id ? '/bibliotheque?vue=' ~ v.id : '/bibliotheque' }}"
                 {% if vueActive and vueActive.id == v.id %}aria-current="true"{% endif %}
                 data-testid="vue-{{ v.id ?? 'toutes' }}">{{ ic.i('vue') }}<span class="libelle">{{ v.nom }}</span><span class="compte">{{ v.compte }}</span></a></li>
          {% endfor %}
        </ul>
        <div class="titre-section">Dossiers du fonds</div>
        <details class="dossiers" data-testid="bloc-dossiers" open><summary data-testid="dossiers-repli">Dossiers{% if dossierActif %} · {{ dossierActif }}{% endif %}</summary>
          <ul class="arbre" data-testid="arbre-dossiers">{% for d in arbre %}<li style="padding-left: {{ d.profondeur * 12 }}px"><a href="/bibliotheque?dossier={{ d.chemin|url_encode }}" data-testid="dossier-{{ d.chemin|replace({'/':'-'}) }}" {% if dossierActif == d.chemin %}aria-current="true"{% endif %}>{{ d.nom }} <span class="compte">{{ d.compte }}</span></a></li>{% endfor %}</ul>
          {% if dossierDroits %}<a class="btn discret" href="{{ dossierDroits.url }}" data-testid="lien-droits-dossier">Droits du dossier{{ ic.i('fleche') }}</a>{% endif %}
        </details>
      </div>
    </aside>

    <section class="carte volet" aria-label="Documents">
      <div class="volet-corps">
        <table class="table" data-testid="liste-documents">
          <colgroup><col style="width:30px"><col><col style="width:104px"><col style="width:24%"><col style="width:86px"><col style="width:84px"></colgroup>
          <thead><tr>
            <th><input type="checkbox" form="formulaire-masse" data-testid="coche-tout-page-entete" aria-label="Toute la page"></th>
            <th>Titre</th><th>Type</th><th>Émetteur</th><th>Date</th><th class="num">Montant</th></tr></thead>
          <tbody>
          {% for d in docs %}
            <tr {% if apercu and apercu.id == d.id %}aria-selected="true"{% endif %} data-testid="ligne-{{ d.id }}">
              <td><input type="checkbox" form="formulaire-masse" name="documents[]" value="{{ d.id }}" data-testid="coche-doc-{{ d.id }}" aria-label="Sélectionner {{ d.titre }}"></td>
              <td><a href="{{ d.lien ?? ('/bibliotheque?doc=' ~ d.id) }}">{{ d.titre }}</a>{% if d.ouverture is defined and d.ouverture %}<span class="chip{% if d.ouverture.abandonnee %} warn{% endif %}" data-testid="ouvert-{{ d.id }}">{% if d.ouverture.abandonnee %}Peut-être abandonné — {% endif %}Ouvert par {{ d.ouverture.auteur }} sur {{ d.ouverture.poste }} depuis {{ d.ouverture.depuis|date('H:i') }}</span>{% endif %}</td>
              <td>{% if d.type %}<span class="chip">{{ d.type }}</span>{% else %}<span class="muted">—</span>{% endif %}</td>
              <td>{{ d.emetteur ?? '—' }}</td>
              <td>{{ d.date ? d.date|date('d.m.Y') : '—' }}</td>
              <td class="num">{{ d.montant is null ? '—' : d.montant|number_format(2, '.', '\'') }}</td>
            </tr>
          {% else %}
            <tr><td colspan="6" class="muted">Aucun document ne satisfait ces filtres.</td></tr>
          {% endfor %}
          </tbody>
        </table>
        {# PERF-3 : la liste est paginée CÔTÉ BASE (100 lignes) — toutes les pièces restent atteignables. #}
        <nav class="pagination" data-testid="pagination" aria-label="Pagination des documents">
          <span class="muted">{{ totalFiltre }} document{{ totalFiltre > 1 ? 's' }} · page {{ page }} / {{ pages }}</span>
          {% if lienPagePrecedente %}<a class="btn discret" href="{{ lienPagePrecedente }}" data-testid="page-precedente">Précédent</a>{% endif %}
          {% if lienPageSuivante %}<a class="btn discret" href="{{ lienPageSuivante }}" data-testid="page-suivante">Suivant</a>{% endif %}
        </nav>
      </div>
    </section>

    <section class="carte volet" aria-label="Aperçu">
      {% if apercu %}
      <div class="volet-tete"><span style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">{{ apercu.titre }}</span>
        {% if apercu.ouvrir is defined and apercu.ouvrir %}<a class="btn primaire" href="{{ apercu.ouvrir.url }}" data-testid="apercu-ouvrir-poste">{{ ic.i('fichier') }}{{ apercu.ouvrir.libelle }}</a>{% endif %}
        <a class="btn discret" style="margin-left:auto" href="/documents/{{ apercu.id }}" data-testid="ouvrir-fiche">Ouvrir{{ ic.i('fleche') }}</a></div>
      {{ visionneuse.moteur(apercu.rendu, 'apercu-visionneuse') }}
      {% if apercu.ouverture is defined and apercu.ouverture %}<p class="alerte{% if apercu.ouverture.abandonnee %} warn{% endif %}" data-testid="apercu-ouverture">{% if apercu.ouverture.abandonnee %}Peut-être abandonné — {% endif %}Ouvert par {{ apercu.ouverture.auteur }} sur {{ apercu.ouverture.poste }} depuis {{ apercu.ouverture.depuis|date('H:i') }}</p>{% endif %}
      <div class="panneau" data-testid="panneau-champs">
        <dl class="meta" data-testid="apercu-meta">
          <dt>Type</dt><dd>{{ apercu.type ?? '—' }}</dd>
          <dt>Émetteur</dt><dd>{{ apercu.emetteur ?? '—' }}</dd>
          <dt>Date</dt><dd>{{ apercu.date ? apercu.date|date('d.m.Y') : '—' }}</dd>
          <dt>Fichier</dt><dd class="mono" data-testid="apercu-chemin">{{ apercu.chemin }}</dd>
        </dl>
        {% if apercu.champs %}
        <form method="post" action="/documents/champ" data-testid="formulaire-champs">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <input type="hidden" name="doc" value="{{ apercu.id }}">
          <div class="titre-section">Champs personnalisés</div>
          {% for c in apercu.champs %}
          <div class="champ"><label for="champ-{{ c.cle }}">{{ c.nom }}{% if c.nature == 'montant' %} (CHF){% endif %}</label>
            {% if c.nature == 'liste' %}
            <select id="champ-{{ c.cle }}" name="champ[{{ c.cle }}]" data-testid="saisie-champ-{{ c.cle }}">
              <option value="">—</option>
              {% for o in c.options %}<option value="{{ o }}" {% if c.valeur == o %}selected{% endif %}>{{ o }}</option>{% endfor %}
            </select>
            {% elseif c.nature == 'booleen' %}
            <select id="champ-{{ c.cle }}" name="champ[{{ c.cle }}]" data-testid="saisie-champ-{{ c.cle }}">
              <option value="">—</option>
              <option value="oui" {% if c.valeur is same as(true) %}selected{% endif %}>Oui</option>
              <option value="non" {% if c.valeur is same as(false) %}selected{% endif %}>Non</option>
            </select>
            {% else %}
            <input id="champ-{{ c.cle }}" name="champ[{{ c.cle }}]" data-testid="saisie-champ-{{ c.cle }}"
                   {% if c.nature == 'date' %}type="date"{% elseif c.nature == 'nombre' %}type="number" step="any"
                   {% elseif c.nature == 'montant' %}type="number" step="0.01"{% else %}type="text"{% endif %}
                   value="{{ c.valeur ?? '' }}">
            {% endif %}
          </div>
          {% endfor %}
          <button class="btn primaire" type="submit" data-testid="action-enregistrer-champs">Enregistrer</button>
          <p class="muted">Les valeurs vivent dans le `.meta.json` à côté du fichier.</p>
        </form>
        {% endif %}
      </div>
      {% else %}
      <div class="volet-corps"><p class="muted">Choisir un document pour voir son aperçu.</p></div>
      {% endif %}
    </section>
  </div>
</div>
{% endblock %}
