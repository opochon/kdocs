{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% import 'partiels/papier.twig' as papier %}
{% import 'partiels/visionneuse.twig' as visionneuse %}
{% block titre %}{{ doc.titre }}{% endblock %}
{% block contenu %}
<div class="page pleine" data-testid="ecran-document">
  <div class="page-tete">
    <div class="titre"><h1>{{ doc.titre }}</h1><span class="chip">{{ doc.type }}</span><span class="chip ok">Validé</span></div>
    <div class="actions">
      {% if doc.statut == 'valide' and peut_sceller and not doc.archivage.scelle %}
      <form method="post" action="/documents/{{ doc.id }}/sceller" class="action-scellement" data-testid="document-confirmation-scellement">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        {% if tsa_configuree %}
        <label><input type="checkbox" required data-testid="document-confirmer-scellement"> Je confirme : le scellement est définitif pendant la rétention légale.</label>
        <button class="btn" type="submit" data-testid="document-sceller">Sceller</button>
        {% else %}
        <span class="muted" data-testid="archivage-tsa-absente">Horodatage externe non configuré : renseignez TSA_URL avant de sceller.</span>
        <button class="btn" type="submit" disabled data-testid="document-sceller">Sceller</button>
        {% endif %}
      </form>
      {% endif %}
      {% if peut_ouvrir_poste %}
      <a class="btn primaire" href="{{ lien_ouverture }}" data-testid="action-ouvrir-poste">{{ ic.i('fichier') }}{{ libelle_ouverture }}</a>
      {% endif %}
      <a class="btn" href="/documents/{{ doc.id }}/fichier" data-testid="action-telecharger">{{ ic.i('telecharger') }}Télécharger</a>
      {% if not doc.archivage.scelle %}
      <form method="post" enctype="multipart/form-data" action="/documents/{{ doc.id }}/versions" data-testid="document-nouvelle-version">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <label class="btn" for="document-fichier-version">{{ ic.i('versions') }}Nouvelle version</label>
        <input id="document-fichier-version" name="fichier" type="file" required data-testid="document-fichier-version">
        <button class="btn" type="submit" data-testid="document-envoyer-version">Envoyer</button>
      </form>
      {% endif %}
      <a class="btn discret" href="/bibliotheque?doc={{ doc.id }}" data-testid="action-retour">Retour à la bibliothèque</a>
    </div>
  </div>
  {% if archivage_succes %}<p class="alerte ok" data-testid="archivage-succes">Document scellé par une TSA publique non qualifiée.</p>{% endif %}
  {% if archivage_erreur %}<p class="alerte erreur" data-testid="archivage-erreur">Scellement refusé : {{ archivage_erreur }}</p>{% endif %}
  {% if version_succes %}<p class="alerte ok" data-testid="version-succes">Nouvelle version v{{ version_succes }} enregistrée.</p>{% endif %}
  {% if version_erreur %}<p class="alerte erreur" data-testid="version-erreur">Nouvelle version refusée : {{ version_erreur }}</p>{% endif %}
  {% if secours_succes %}<p class="alerte ok" data-testid="secours-succes">Copie de secours récupérée : nouvelle version v{{ secours_succes }} créée.</p>{% endif %}
  {% if secours_erreur %}<p class="alerte erreur" data-testid="secours-erreur">Récupération refusée : {{ secours_erreur }}</p>{% endif %}
  {% if doc.ouverture %}
  <p class="alerte{% if doc.ouverture.abandonnee %} warn{% endif %}" data-testid="document-ouverture">{% if doc.ouverture.abandonnee %}Peut-être abandonné — {% endif %}Ouvert par {{ doc.ouverture.auteur }} sur {{ doc.ouverture.poste }} depuis {{ doc.ouverture.depuis|date('H:i') }}</p>
  {% endif %}
  <section class="archivage-etat carte" data-testid="archivage-etat">
    {% if doc.archivage.scelle %}
    <strong>Scellé le {{ doc.archivage.scelle_le|date('d.m.Y à H:i') }}</strong><span>TSA publique non qualifiée : <span class="mono">{{ doc.archivage.tsa_url }}</span></span><span>Jeton TSA : <span class="mono">{{ doc.archivage.tsa_jeton }}</span></span><span>Rétention jusqu’au {{ doc.archivage.echeance }}</span>
    {% else %}
    <strong>Non scellé</strong><span>Ce document n’est pas encore archivé légalement.</span>
    {% endif %}
  </section>
  <section class="archivage-etat carte" data-testid="pdfa-etat">
    {% if doc.pdfa.statut == 'ok' %}
    <strong data-testid="pdfa-statut-ok">Copie d’archivage PDF/A-2b disponible</strong>
    <span class="mono" data-testid="pdfa-chemin">{{ doc.pdfa.chemin }}</span>
    <a class="btn discret" href="/documents/{{ doc.id }}/pdfa" data-testid="pdfa-telecharger">Télécharger la copie PDF/A</a>
    {% elseif doc.pdfa.statut == 'echec' %}
    <strong data-testid="pdfa-statut-echec">Copie d’archivage PDF/A en échec</strong>
    <span data-testid="pdfa-raison">{{ doc.pdfa.raison }}</span>
    {% if doc.pdfa.reprise == 'auto' %}
    <span class="muted" data-testid="pdfa-reprenable">Cause d’environnement : le rattrapage la reprendra sans toucher à l’original.</span>
    {% else %}
    <span class="muted" data-testid="pdfa-definitif">Cause attachée au document : aucune relance automatique.</span>
    {% endif %}
    {% elseif doc.pdfa.statut == 'en_attente' %}
    <strong data-testid="pdfa-statut-attente">Copie d’archivage PDF/A en attente</strong>
    <span class="muted">Le rattrapage la produira depuis l’écran Application.</span>
    {% else %}
    <strong data-testid="pdfa-statut-sans-objet">Copie d’archivage PDF/A sans objet</strong>
    <span class="muted">Seuls les PDF et les images ont une copie d’archivage.</span>
    {% endif %}
  </section>
  <div class="volets fiche">
    <section class="carte volet volet-apercu" aria-label="Aperçu">
      {% if doc.rendu is defined %}
        {# Document du fonds : la MÊME visionneuse que la Bibliothèque et À traiter (macro du secteur Aperçu). #}
        {{ visionneuse.moteur(doc.rendu, 'apercu') }}
      {% else %}
        <div class="visionneuse" data-testid="apercu">{{ papier.page(doc.texte, 'apercu-page') }}</div>
      {% endif %}
    </section>
    <section class="carte volet" aria-label="Fiche" data-onglets>
      <div class="onglets" role="tablist">
        {% for o in ['Métadonnées', 'Versions', 'Historique', 'Notes', 'Liens', 'Partager'] %}
          <button type="button" role="tab" aria-selected="{{ loop.first ? 'true' : 'false' }}" aria-controls="p-{{ loop.index }}" data-testid="onglet-{{ o|lower }}">{{ o }}</button>
        {% endfor %}
      </div>
      <div class="volet-corps">
        <div class="panneau" id="p-1" role="tabpanel">
          <dl class="meta" data-testid="panneau-metadonnees">
            <dt>Type</dt><dd>{{ doc.type ?: '—' }}</dd><dt>Émetteur</dt><dd>{{ doc.emetteur ?: '—' }}</dd>
            <dt>Date</dt><dd>{{ doc.date ? doc.date|date('d.m.Y') : '—' }}</dd>
            <dt>Montant</dt><dd class="num" style="text-align:left">{{ doc.montant is null ? '—' : 'CHF ' ~ doc.montant|number_format(2, '.', '\'') }}</dd>
            <dt>Dossier</dt><dd class="mono">{{ doc.dossier }}/</dd><dt>Fichier</dt><dd class="mono">{{ doc.fichier }}</dd>
            <dt>Métadonnées</dt><dd class="mono">{{ doc.fichier }}.meta.json</dd>
            {# Lot ged-parite-final-1 : champs Paperless du Document, tels que la fiche les connaît. #}
            <dt>Propriétaire</dt><dd data-testid="document-proprietaire">{{ doc.proprietaire ?: '—' }}</dd>
            <dt>Nom d’origine</dt><dd class="mono" data-testid="document-nom-origine">{{ doc.nom_origine ?: '—' }}</dd>
            <dt>Pages</dt><dd class="num" style="text-align:left" data-testid="document-pages">{{ doc.pages > 0 ? doc.pages : '—' }}</dd>
            <dt>N° d’archive</dt><dd class="mono" data-testid="document-asn">{{ doc.asn ?: '—' }}</dd>
            <dt>Type de stockage</dt><dd class="mono" data-testid="document-storage-type">{{ doc.storage_type }}</dd>
          </dl>
        </div>
        <div class="panneau" id="p-2" role="tabpanel" hidden>
          <ul class="chrono" data-testid="panneau-versions">
            {% for v in doc.versions %}<li><span class="mono">v{{ v.n }} · {{ v.quand }}</span><span>{{ v.quoi }} <span class="muted">— {{ v.qui }}, {{ v.taille }}</span></span>{% if not doc.archivage.scelle %}<form method="post" action="/documents/{{ doc.id }}/versions/{{ v.n }}/restaurer"><input type="hidden" name="csrf" value="{{ csrf }}"><button class="btn discret" type="submit" data-testid="restaurer-version-{{ v.n }}">Restaurer v{{ v.n }}</button></form>{% endif %}</li>{% else %}<li class="muted">Aucune version archivée.</li>{% endfor %}
          </ul>
          <div class="titre-section" data-testid="secours-titre">Copies de secours</div>
          <ul class="chrono" data-testid="panneau-secours">
            {% for c in doc.secours %}
            <li data-testid="secours-copie">
              <span class="mono">{{ c.quand }}</span>
              <span>{{ c.nom }} <span class="muted">— {{ c.appareil }}, {{ c.taille_lisible }}, empreinte {{ c.empreinte|slice(0, 8) }}</span></span>
              {% if peut_modifier and not doc.archivage.scelle %}
              <form method="post" action="/documents/{{ doc.id }}/secours/recuperer" data-testid="secours-recuperer-form">
                <input type="hidden" name="csrf" value="{{ csrf }}">
                <input type="hidden" name="copie" value="{{ c.id }}">
                <label><input type="checkbox" required data-testid="secours-confirmer"> Je confirme : une nouvelle version sera créée à partir de cette copie.</label>
                <button class="btn discret" type="submit" data-testid="secours-recuperer">Récupérer la copie</button>
              </form>
              {% endif %}
            </li>
            {% else %}
            <li class="muted">Aucune copie de secours.</li>
            {% endfor %}
          </ul>
        </div>
        <div class="panneau" id="p-3" role="tabpanel" hidden>
          <ul class="chrono" data-testid="panneau-historique">{% for h in doc.historique %}<li><span class="mono">{{ h.quand }}</span><span>{{ h.quoi }}</span></li>{% else %}<li class="muted">Aucun déplacement enregistré.</li>{% endfor %}</ul>
        </div>
        <div class="panneau" id="p-4" role="tabpanel" hidden data-testid="panneau-notes">
          <form method="post" action="/documents/{{ doc.id }}/notes" data-testid="note-ajouter"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="ajouter"><label>Nouvelle note <textarea name="texte" required maxlength="8000" data-testid="note-texte"></textarea></label><button class="btn" type="submit" data-testid="note-enregistrer">Ajouter la note</button></form>
          <ul class="chrono">{% for note in doc.notes %}<li><span class="mono">{{ note.auteur }} · {{ note.cree_le }}{% if note.maj_le != note.cree_le %} · modifiée {{ note.maj_le }}{% endif %}</span><span>{{ note.texte }}</span>{% if note.auteur == auteur_courant %}<form method="post" action="/documents/{{ doc.id }}/notes" data-testid="note-modifier-{{ note.id }}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="modifier"><input type="hidden" name="note" value="{{ note.id }}"><label>Modifier ma note <textarea name="texte" required maxlength="8000" data-testid="note-texte-{{ note.id }}">{{ note.texte }}</textarea></label><button class="btn discret" type="submit" data-testid="note-enregistrer-{{ note.id }}">Enregistrer</button></form><form method="post" action="/documents/{{ doc.id }}/notes"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="retirer"><input type="hidden" name="note" value="{{ note.id }}"><button class="btn discret" type="submit" data-testid="note-retirer-{{ note.id }}">Retirer ma note</button></form>{% endif %}</li>{% else %}<li class="muted">Aucune note.</li>{% endfor %}</ul>
        </div>
        <div class="panneau" id="p-5" role="tabpanel" hidden data-testid="panneau-liens">
          <form method="post" action="/documents/{{ doc.id }}/liens" data-testid="lien-ajouter"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="lier"><label>Document cible <input name="cible" type="number" min="1" required data-testid="lien-cible"></label><label>Libellé <input name="libelle" maxlength="128" required data-testid="lien-libelle"></label><button class="btn" type="submit" data-testid="lien-enregistrer">Lier</button></form>
          <ul class="chrono">{% for lien in doc.liens %}<li><a href="/documents/{{ lien.document }}">{{ lien.titre }}</a><span>{{ lien.libelle }}</span><form method="post" action="/documents/{{ doc.id }}/liens"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="retirer"><input type="hidden" name="lien" value="{{ lien.id }}"><button class="btn discret" type="submit" data-testid="lien-retirer-{{ lien.id }}">Retirer</button></form></li>{% else %}<li class="muted">Aucun lien.</li>{% endfor %}</ul>
        </div>
        <div class="panneau" id="p-6" role="tabpanel" hidden data-testid="panneau-partager">
          <form method="post" action="/documents/{{ doc.id }}/partages" data-testid="partage-interne"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="interne"><label>Destinataire <select name="cible_type"><option value="compte">Compte</option><option value="groupe">Groupe</option></select></label><input name="cible" type="number" min="1" required data-testid="partage-cible"><button class="btn" type="submit" data-testid="partage-interne-envoyer">Partager en interne</button></form>
          {% if peut_partager_externe %}<form method="post" action="/documents/{{ doc.id }}/partages/externe" data-testid="partage-externe-creer"><input type="hidden" name="csrf" value="{{ csrf }}"><label>Expiration obligatoire <input type="date" name="expiration" required data-testid="partage-expiration"></label><button class="btn" type="submit" data-testid="partage-externe-envoyer">Créer le lien externe</button></form>{% endif %}
          {% if partage_lien %}<p class="alerte ok" data-testid="partage-lien">Copiez ce lien maintenant : <code>{{ partage_lien }}</code></p>{% endif %}
          <ul class="chrono">{% for partage in doc.partages %}<li><span>{{ partage.type }} · {{ partage.cible }}</span>{% if partage.revoque_le %}<span class="muted" data-testid="partage-etat-revoque-{{ partage.id }}">révoqué le {{ partage.revoque_le }}</span>{% elseif partage.expire_le and partage.expire_le < 'now'|date('Y-m-d H:i:s') %}<span class="muted" data-testid="partage-etat-expire-{{ partage.id }}">expiré le {{ partage.expire_le }}</span>{% elseif partage.expire_le %}<span class="muted" data-testid="partage-etat-echance-{{ partage.id }}">expire le {{ partage.expire_le }}</span>{% endif %}{% if not partage.revoque_le and (partage.type == 'interne' or peut_partager_externe) %}<form method="post" action="/documents/{{ doc.id }}/partages{% if partage.type == 'externe' %}/externe{% endif %}"><input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="revoquer"><input type="hidden" name="partage" value="{{ partage.id }}"><button class="btn discret" type="submit" data-testid="partage-{{ partage.type }}-revoquer-{{ partage.id }}">Révoquer</button></form>{% endif %}</li>{% else %}<li class="muted">Aucun partage.</li>{% endfor %}</ul>
        </div>
      </div>
    </section>
  </div>
</div>
{% endblock %}
