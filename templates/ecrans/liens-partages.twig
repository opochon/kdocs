{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% block titre %}Liens de partage{% endblock %}
{% block contenu %}
<div class="page" data-testid="ecran-liens-partages">
  <div class="page-tete">
    <div class="titre">
      <h1>Liens de partage</h1>
      <span class="muted">Liens externes actifs. Le secret n’est montré qu’à la création et n’est jamais conservé en clair.</span>
    </div>
    <div class="actions">
      <a class="btn" href="/favoris" data-testid="liens-lien-espace">{{ ic.i('favori') }}Mon espace</a>
      <a class="btn discret" href="/bibliotheque" data-testid="liens-lien-bibliotheque">{{ ic.i('biblio') }}Bibliothèque</a>
    </div>
  </div>

  <section class="carte">
    <ul class="chrono" data-testid="liens-partages-liste">
      {% for p in partages %}
      <li data-testid="lien-partage-{{ p.id }}">
        <a href="/documents/{{ p.document }}" data-testid="lien-partage-document-{{ p.id }}">{{ p.titre }}</a>
        <span class="muted">créé par {{ p.auteur }} le {{ p.cree_le }}{% if p.version %} · version {{ p.version }}{% endif %}</span>
        {% if p.expire_le %}
          {% if p.expire_le < 'now'|date('Y-m-d H:i:s') %}
          <span class="muted" data-testid="lien-partage-expire-{{ p.id }}">expiré le {{ p.expire_le }}</span>
          {% else %}
          <span class="muted" data-testid="lien-partage-echeance-{{ p.id }}">expire le {{ p.expire_le }}</span>
          {% endif %}
        {% endif %}
        <form method="post" action="/liens-partages/{{ p.id }}/revoquer">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <button class="btn discret" type="submit" data-testid="lien-partage-revoquer-{{ p.id }}">Révoquer</button>
        </form>
      </li>
      {% else %}
      <li class="muted" data-testid="liens-partages-vide">Aucun lien de partage actif.</li>
      {% endfor %}
    </ul>
  </section>
</div>
{% endblock %}
