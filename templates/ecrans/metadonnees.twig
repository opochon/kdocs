{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% block titre %}Métadonnées{% endblock %}
{% block contenu %}
<div class="page pleine" data-testid="ecran-metadonnees">
  <div class="page-tete">
    <div class="titre">
      <h1>Métadonnées</h1>
      <span class="muted">La nomenclature des types et les champs personnalisés · un type ne se supprime jamais, il se désactive</span>
    </div>
    <div class="actions">
      <a class="btn discret" href="/application" data-testid="retour-application">{{ ic.i('reglages') }}Application</a>
    </div>
  </div>

  <div class="volets fiche">
    <section class="carte volet" aria-label="Nomenclature des types">
      <div class="volet-tete">Nomenclature des types</div>
      <div class="volet-corps">
        <table class="table" data-testid="table-types">
          <thead><tr><th>Type</th><th style="width:90px">État</th><th style="width:230px">Actions</th></tr></thead>
          <tbody>
          {% for t in types %}
            <tr {% if typeChoisi and typeChoisi.id == t.id %}aria-selected="true"{% endif %} data-testid="type-{{ t.id }}">
              <td><a href="/metadonnees?type={{ t.id }}">{{ t.nom }}</a></td>
              <td>{% if t.actif %}<span class="chip">actif</span>{% else %}<span class="chip warn">désactivé</span>{% endif %}</td>
              <td>
                <form class="rangée" method="post" action="/metadonnees/type" style="display:flex;gap:6px;align-items:center">
                  <input type="hidden" name="csrf" value="{{ csrf }}">
                  <input type="hidden" name="id" value="{{ t.id }}">
                  <input type="hidden" name="action" value="renommer">
                  <input name="nom" value="{{ t.nom }}" aria-label="Nouveau nom de {{ t.nom }}" style="width:110px;height:26px;border:1px solid var(--border-strong);border-radius:var(--r-sm);background:var(--surface);color:var(--text);font:inherit;padding:0 6px">
                  <button class="btn discret" type="submit" data-testid="action-renommer-{{ t.id }}">Renommer</button>
                </form>
                <form method="post" action="/metadonnees/type">
                  <input type="hidden" name="csrf" value="{{ csrf }}">
                  <input type="hidden" name="id" value="{{ t.id }}">
                  <input type="hidden" name="action" value="{{ t.actif ? 'desactiver' : 'activer' }}">
                  <button class="btn discret" type="submit" data-testid="action-basculer-{{ t.id }}">{{ t.actif ? 'Désactiver' : 'Réactiver' }}</button>
                </form>
              </td>
            </tr>
          {% endfor %}
          </tbody>
        </table>
        {% if graineAPoser %}
        <form method="post" action="/metadonnees/type" data-testid="formule-graine" style="padding:10px 14px">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <input type="hidden" name="action" value="graine">
          <button class="btn primaire" type="submit" data-testid="action-poser-graine">Poser les six types livrés</button>
          <p class="muted" style="margin:8px 0 0">Facture, Note de crédit, Reçu, Contrat, Courrier, Document RH — la nomenclature du plan, écrite dans le fonds.</p>
        </form>
        {% endif %}
        <form method="post" action="/metadonnees/type" data-testid="formulaire-nouveau-type">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <input type="hidden" name="action" value="ajouter">
          <div class="titre-section" style="padding:10px 14px 0">Ajouter un type</div>
          <div class="champ"><label for="nom-type">Nom du type</label>
            <input id="nom-type" name="nom" data-testid="nom-nouveau-type" placeholder="p. ex. Convention"></div>
          <div style="padding:10px 14px"><button class="btn primaire" type="submit" data-testid="action-ajouter-type">Ajouter</button></div>
        </form>
      </div>
    </section>

    <section class="carte volet" aria-label="Champs personnalisés">
      {% if typeChoisi %}
      <div class="volet-tete">Champs de « {{ typeChoisi.nom }} »</div>
      <div class="volet-corps">
        <ul class="liste" data-testid="champs-{{ typeChoisi.slug }}">
          {% for c in champsDuType %}
          <li class="champ" data-testid="champ-{{ c.cle }}">
            <span class="l1">{{ c.nom }}{% if c.obligatoire %} <span class="chip warn" data-testid="champ-{{ c.cle }}-obligatoire">obligatoire</span>{% endif %}</span>
            <span class="l2">clé `{{ c.cle }}` · nature {{ c.nature }}{% if c.liste %} · liste nommée « {{ c.liste }} »{% endif %}{% if c.options %} · valeurs : {{ c.options|join(', ') }}{% endif %}</span>
            <form method="post" action="/metadonnees/champ" class="inline">
              <input type="hidden" name="csrf" value="{{ csrf }}">
              <input type="hidden" name="action" value="{{ c.actif ? 'desactiver' : 'reactiver' }}">
              <input type="hidden" name="id" value="{{ c.id }}">
              <input type="hidden" name="type" value="{{ typeChoisi.id }}">
              <span class="chip{% if not c.actif %} warn{% endif %}" data-testid="champ-{{ c.cle }}-etat">{{ c.actif ? 'actif' : 'en veille' }}</span>
              <button class="btn discret" type="submit" data-testid="champ-{{ c.cle }}-basculer">{{ c.actif ? 'Retirer' : 'Réactiver' }}</button>
            </form>
          </li>
          {% else %}
          <li class="champ muted" data-testid="aucun-champ">Aucun champ sur ce type.</li>
          {% endfor %}
        </ul>
        {% if carteApercu and carteApercu.proprietes %}
        <div class="panneau" data-testid="carte-classe-{{ typeChoisi.slug }}">
          <div class="titre-section">Carte de la classe « {{ typeChoisi.nom }} »</div>
          <table class="table" data-testid="carte-classe-table">
            <thead><tr><th>Propriété</th><th>Nature</th><th>Obligatoire</th><th>Valeurs</th></tr></thead>
            <tbody>
            {% for p in carteApercu.proprietes %}
              <tr data-testid="carte-propriete-{{ p.cle }}">
                <td>{{ p.nom }}</td>
                <td>{{ p.nature }}</td>
                <td data-testid="carte-propriete-{{ p.cle }}-obligatoire">{{ p.obligatoire ? 'oui' : 'non' }}</td>
                <td>{% if p.liste %}liste « {{ p.liste }} » : {{ p.options|join(', ') }}{% elseif p.options %}{{ p.options|join(', ') }}{% else %}—{% endif %}</td>
              </tr>
            {% endfor %}
            </tbody>
          </table>
        </div>
        {% endif %}
        <form method="post" action="/metadonnees/champ" data-testid="formulaire-nouveau-champ">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <div class="titre-section" style="padding:10px 14px 0">Ajouter un champ sur un type</div>
          <div class="champ"><label for="champ-type">Type de document</label>
            <select id="champ-type" name="type" data-testid="champ-type-doc">
              {% for t in types %}{% if t.actif %}<option value="{{ t.id }}" {% if typeChoisi.id == t.id %}selected{% endif %}>{{ t.nom }}</option>{% endif %}{% endfor %}
            </select></div>
          <div class="champ"><label for="champ-nom">Nom du champ</label>
            <input id="champ-nom" name="nom" data-testid="champ-nom-champ" placeholder="p. ex. Échéance"></div>
          <div class="champ"><label for="champ-nature">Nature</label>
            <select id="champ-nature" name="nature" data-testid="champ-nature">
              <option value="texte">texte</option>
              <option value="nombre">nombre</option>
              <option value="montant">montant CHF</option>
              <option value="date">date</option>
              <option value="liste">liste</option>
              <option value="booleen">oui/non</option>
              <option value="url">url</option>
              <option value="lien">lien vers des documents</option>
            </select></div>
          <div class="champ"><label for="champ-liste">Liste nommée (nature liste)</label>
            <select id="champ-liste" name="liste" data-testid="champ-liste">
              <option value="">— aucune (options en ligne) —</option>
              {% for l in listesPourChamp %}<option value="{{ l.cle }}">{{ l.nom }}</option>{% endfor %}
            </select></div>
          <label class="case"><input type="checkbox" name="obligatoire" value="1" data-testid="champ-obligatoire"> Propriété obligatoire de la classe</label>
          <div class="champ"><label for="champ-options">Options (nature liste SANS liste nommée — une par ligne)</label>
            <textarea id="champ-options" name="options" data-testid="champ-options" style="width:100%;min-height:56px;border:1px solid var(--border-strong);border-radius:var(--r-sm);background:var(--surface);color:var(--text);font:inherit;padding:6px 9px"></textarea></div>
          <div style="padding:10px 14px"><button class="btn primaire" type="submit" data-testid="action-ajouter-champ">Ajouter le champ</button>
            <p class="muted" style="margin:8px 0 0">La nature ne se change plus après création : des valeurs typées vivront dans le dossier.</p></div>
        </form>
      </div>
      {% else %}
      <div class="volet-corps"><p class="muted" style="padding:12px 14px">La nomenclature est vide : ajouter un premier type.</p></div>
      {% endif %}
    </section>

    <section class="carte" data-testid="listes-admin">
      <h2>Listes de valeurs nommées</h2>
      <p class="muted">Un vocabulaire contrôlé réutilisable qu’une propriété de nature liste référence. Une valeur n’est jamais effacée : on la retire (datée et attribuée), elle reste traçable.</p>
      {% for l in listes %}
      <div data-testid="liste-{{ l.id }}">
        <div class="titre-section">{{ l.nom }} <span class="mono muted">{{ l.cle }}</span>
          {% if l.actif %}<span class="chip">active</span>{% else %}<span class="chip warn">en veille</span>{% endif %}</div>
        <table class="table" data-testid="liste-{{ l.id }}-valeurs">
          <thead><tr><th>Valeur</th><th>État</th><th>Trace du retrait</th><th>Actions</th></tr></thead>
          <tbody>
          {% for v in l.valeurs %}
            <tr data-testid="liste-{{ l.id }}-valeur-{{ v.id }}">
              <td>{{ v.libelle }}</td>
              <td>{% if v.actif %}<span class="chip">active</span>{% else %}<span class="chip warn">retirée</span>{% endif %}</td>
              <td class="muted">{% if v.retire_le is defined and v.retire_le %}retirée le {{ v.retire_le }}{% if v.retire_par is defined and v.retire_par %} par {{ v.retire_par }}{% endif %}{% endif %}</td>
              <td>
                <form method="post" action="/metadonnees/liste/valeur" style="display:flex;gap:6px;align-items:center">
                  <input type="hidden" name="csrf" value="{{ csrf }}">
                  <input type="hidden" name="liste" value="{{ l.id }}">
                  <input type="hidden" name="valeur" value="{{ v.id }}">
                  <input type="hidden" name="action" value="{{ v.actif ? 'retirer' : 'reactiver' }}">
                  <button class="btn discret" type="submit" data-testid="liste-{{ l.id }}-valeur-{{ v.id }}-basculer">{{ v.actif ? 'Retirer' : 'Réactiver' }}</button>
                </form>
                <form method="post" action="/metadonnees/liste/valeur" style="display:flex;gap:6px;align-items:center;margin-top:4px">
                  <input type="hidden" name="csrf" value="{{ csrf }}">
                  <input type="hidden" name="liste" value="{{ l.id }}">
                  <input type="hidden" name="valeur" value="{{ v.id }}">
                  <input type="hidden" name="action" value="renommer">
                  <input name="libelle" value="{{ v.libelle }}" size="14" aria-label="Renommer {{ v.libelle }}" data-testid="liste-{{ l.id }}-valeur-{{ v.id }}-libelle">
                  <button class="btn discret" type="submit" data-testid="liste-{{ l.id }}-valeur-{{ v.id }}-renommer">Renommer</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr><td colspan="4" class="muted" data-testid="liste-{{ l.id }}-vide">Aucune valeur.</td></tr>
          {% endfor %}
          </tbody>
        </table>
        <form method="post" action="/metadonnees/liste/valeur" style="display:flex;gap:6px;align-items:center;padding:0 14px 10px">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <input type="hidden" name="liste" value="{{ l.id }}">
          <input type="hidden" name="action" value="ajouter">
          <input name="libelle" placeholder="nouvelle valeur" aria-label="Nouvelle valeur de {{ l.nom }}" data-testid="liste-{{ l.id }}-nouvelle-valeur">
          <button class="btn primaire" type="submit" data-testid="liste-{{ l.id }}-ajouter-valeur">Ajouter la valeur</button>
        </form>
        <form method="post" action="/metadonnees/liste" style="display:flex;gap:6px;align-items:center;padding:0 14px 10px">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <input type="hidden" name="id" value="{{ l.id }}">
          <input type="hidden" name="action" value="renommer">
          <input name="nom" value="{{ l.nom }}" size="16" aria-label="Renommer la liste {{ l.nom }}" data-testid="liste-{{ l.id }}-nom">
          <button class="btn discret" type="submit" data-testid="liste-{{ l.id }}-renommer">Renommer la liste</button>
        </form>
        <form method="post" action="/metadonnees/liste" style="padding:0 14px 12px">
          <input type="hidden" name="csrf" value="{{ csrf }}">
          <input type="hidden" name="id" value="{{ l.id }}">
          <input type="hidden" name="action" value="{{ l.actif ? 'desactiver' : 'activer' }}">
          <button class="btn discret" type="submit" data-testid="liste-{{ l.id }}-basculer">{{ l.actif ? 'Mettre en veille' : 'Réactiver' }}</button>
        </form>
      </div>
      {% else %}
      <p class="muted" style="padding:0 14px" data-testid="listes-vide">Aucune liste nommée.</p>
      {% endfor %}
      <form method="post" action="/metadonnees/liste">
        <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="ajouter">
        <div class="champ"><label for="liste-nom">Nom de la liste</label>
          <input id="liste-nom" name="nom" data-testid="liste-nouveau-nom" placeholder="p. ex. Service"></div>
        <button class="btn primaire" type="submit" data-testid="action-ajouter-liste">Ajouter la liste</button>
      </form>
      <form method="post" action="/metadonnees/definition" style="padding:0 14px 12px;display:flex;gap:8px;align-items:center">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <button class="btn discret" type="submit" name="action" value="exporter" data-testid="action-exporter-definition">Exporter la définition</button>
        <button class="btn discret" type="submit" name="action" value="importer" data-testid="action-importer-definition">Importer la définition</button>
        <span class="muted">fichier portable <span class="mono">.ged/definition.json</span></span>
      </form>
    </section>

    <section class="carte" data-testid="etiquettes-admin">
      <h2>Étiquettes</h2>
      <p class="muted">Une étiquette a un nom, une couleur, une parente (hiérarchie) et peut être la boîte de réception du fonds. Elle n’est jamais supprimée : on la met en veille.</p>
      <table class="table" data-testid="etiquettes-liste">
        <thead><tr><th>Nom</th><th>Couleur</th><th>Parente</th><th>Boîte de réception</th><th>État</th><th></th></tr></thead>
        <tbody>
        {% for e in etiquettes %}
          <tr data-testid="etiquette-{{ e.id }}">
            <td>{{ e.nom }}</td>
            <td><span class="chip" style="background:{{ e.couleur }};color:#fff" data-testid="etiquette-{{ e.id }}-couleur">{{ e.couleur }}</span></td>
            <td data-testid="etiquette-{{ e.id }}-parent">
              <form method="post" action="/metadonnees/etiquette"><input type="hidden" name="csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="parent"><input type="hidden" name="id" value="{{ e.id }}">
                <select name="parent" data-testid="etiquette-{{ e.id }}-parent-saisie">
                  <option value="">— racine —</option>
                  {% for p in parentsEtiquettePossibles %}{% if p.id != e.id %}<option value="{{ p.id }}"{% if e.parent == p.id %} selected{% endif %}>{{ p.nom }}</option>{% endif %}{% endfor %}
                </select>
                <button class="btn discret" type="submit" data-testid="etiquette-{{ e.id }}-parenter">Rattacher</button></form>
            </td>
            <td>
              <form method="post" action="/metadonnees/etiquette"><input type="hidden" name="csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="boite"><input type="hidden" name="id" value="{{ e.id }}">
                <input type="hidden" name="valeur" value="{{ e.boite_reception ? '0' : '1' }}">
                <button class="btn discret" type="submit" data-testid="etiquette-{{ e.id }}-boite">{{ e.boite_reception ? 'Retirer' : 'Poser' }}</button></form>
            </td>
            <td>
              <form method="post" action="/metadonnees/etiquette"><input type="hidden" name="csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="actif"><input type="hidden" name="id" value="{{ e.id }}">
                <input type="hidden" name="valeur" value="{{ e.actif ? '0' : '1' }}">
                <span class="chip{% if not e.actif %} warn{% endif %}" data-testid="etiquette-{{ e.id }}-etat">{{ e.actif ? 'active' : 'en veille' }}</span>
                <button class="btn discret" type="submit" data-testid="etiquette-{{ e.id }}-basculer">{{ e.actif ? 'Retirer' : 'Réactiver' }}</button></form>
            </td>
            <td>
              <form method="post" action="/metadonnees/etiquette" style="display:flex;gap:6px"><input type="hidden" name="csrf" value="{{ csrf }}">
                <input type="hidden" name="action" value="couleur"><input type="hidden" name="id" value="{{ e.id }}">
                <input name="couleur" value="{{ e.couleur }}" size="8" data-testid="etiquette-{{ e.id }}-couleur-saisie">
                <button class="btn discret" type="submit" data-testid="etiquette-{{ e.id }}-recolorer">Recolorer</button></form>
            </td>
          </tr>
        {% else %}
          <tr><td colspan="6" class="muted" data-testid="etiquettes-vide">Aucune étiquette.</td></tr>
        {% endfor %}
        </tbody>
      </table>
      <form method="post" action="/metadonnees/etiquette">
        <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="action" value="ajouter">
        <div class="champ"><label for="etiquette-nom">Nom de l’étiquette</label>
          <input id="etiquette-nom" name="nom" data-testid="etiquette-nom" required></div>
        <div class="champ"><label for="etiquette-couleur">Couleur (#RRGGBB)</label>
          <input id="etiquette-couleur" name="couleur" value="{{ couleurEtiquetteDefaut }}" data-testid="etiquette-couleur"></div>
        <div class="champ"><label for="etiquette-parent">Parente (facultatif)</label>
          <select id="etiquette-parent" name="parent" data-testid="etiquette-parent">
            <option value="">— racine —</option>
            {% for p in parentsEtiquettePossibles %}<option value="{{ p.id }}">{{ p.nom }}</option>{% endfor %}
          </select></div>
        <label class="case"><input type="checkbox" name="boite_reception" value="1" data-testid="etiquette-boite"> Boîte de réception</label>
        <button class="btn primaire" type="submit" data-testid="action-ajouter-etiquette">Ajouter l’étiquette</button>
      </form>
    </section>
  </div>
</div>
{% endblock %}
