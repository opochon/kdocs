{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% block titre %}Recherche{% endblock %}
{% block contenu %}
<div class="page" data-testid="ecran-recherche">
  <div class="page-tete">
    <div class="titre">
      <h1>Recherche</h1>
      <span class="muted" data-testid="recherche-compte">{{ total }} résultat{{ total > 1 ? 's' : '' }}{% if q %} pour « {{ q }} »{% endif %} · {{ duree }} s{% if mode == 'like' %} · repli mot à mot{% endif %}</span>
    </div>
    <div class="actions">
      {% if not (semblable is defined and semblables_actifs) %}
      <form class="filtres" data-testid="filtres" action="/recherche" method="get" role="search">
        <input type="hidden" name="q" value="{{ q }}">
        {# V2-10b : sur téléphone, les filtres vivent derrière un bouton « Filtres » qui ouvre un panneau
           pleine largeur, un champ par ligne. Sur ordinateur, le panneau est `display:contents` : la
           rangée de puces reste identique. Ouvert par défaut (sans JS, l'ordinateur est complet), le JS
           le replie au point de rupture téléphone. #}
        <details class="filtres-panneau" data-testid="filtres-panneau" open>
          <summary class="btn discret" data-testid="action-filtres">{{ ic.i('vue') }}Filtres{% if filtres_actifs %}<span class="filtres-actifs" aria-hidden="true">●</span>{% endif %}</summary>
          <div class="filtres-champs">
            <label class="chip" for="filtre-type">Type
              <select id="filtre-type" name="type" data-testid="filtre-type">
                <option value="">tous</option>
                {% for t in types_filtre %}<option value="{{ t }}"{% if filtres.type == t %} selected{% endif %}>{{ t }}</option>{% endfor %}
              </select>
            </label>
            <label class="chip" for="filtre-emetteur">Émetteur
              <input id="filtre-emetteur" name="emetteur" value="{{ filtres.emetteur }}" data-testid="filtre-emetteur" size="10">
            </label>
            <label class="chip" for="filtre-date-debut">Du
              <input id="filtre-date-debut" type="date" name="date_debut" value="{{ filtres.date_debut }}" data-testid="filtre-date-debut">
            </label>
            <label class="chip" for="filtre-date-fin">Au
              <input id="filtre-date-fin" type="date" name="date_fin" value="{{ filtres.date_fin }}" data-testid="filtre-date-fin">
            </label>
            <label class="chip" for="filtre-montant-min">Montant min
              <input id="filtre-montant-min" name="montant_min" value="{{ filtres.montant_min }}" data-testid="filtre-montant-min" size="6">
            </label>
            <label class="chip" for="filtre-montant-max">max
              <input id="filtre-montant-max" name="montant_max" value="{{ filtres.montant_max }}" data-testid="filtre-montant-max" size="6">
            </label>
          </div>
          <div class="filtres-pied">
            <button class="btn discret" type="submit" data-testid="action-filtrer">Filtrer</button>
            {% if filtres_actifs %}<a class="btn discret" href="/recherche?q={{ q|url_encode }}" data-testid="action-effacer-filtres">Effacer les filtres</a>{% endif %}
          </div>
        </details>
      </form>
      <details data-testid="bloc-vue-recherche"><summary class="btn discret" style="list-style:none;cursor:pointer" data-testid="action-enregistrer-vue-recherche">Enregistrer comme vue</summary>
        <form class="panneau" method="post" action="/recherche/vue" data-testid="formulaire-vue-recherche">
          <input type="hidden" name="csrf" value="{{ csrf }}"><input type="hidden" name="q" value="{{ q }}"><input type="hidden" name="type" value="{{ filtres.type }}"><input type="hidden" name="emetteur" value="{{ filtres.emetteur }}"><input type="hidden" name="date_debut" value="{{ filtres.date_debut }}"><input type="hidden" name="date_fin" value="{{ filtres.date_fin }}"><input type="hidden" name="montant_min" value="{{ filtres.montant_min }}"><input type="hidden" name="montant_max" value="{{ filtres.montant_max }}">
          <label for="nom-vue-recherche">Nom de la vue</label><input id="nom-vue-recherche" name="nom" required data-testid="nom-vue-recherche"><button class="btn primaire" type="submit" data-testid="action-creer-vue-recherche">Créer la vue</button>
        </form>
      </details>
      {% endif %}
    </div>
  </div>

  {% if semblable is defined and semblables_actifs %}
    {% if semblable %}
    <div class="carte" data-testid="recherche-semblables" style="padding:10px 16px;margin-bottom:12px">
      <strong>Documents semblables</strong> à « <a href="/documents/{{ semblable.id }}" data-testid="semblables-source">{{ semblable.titre }}</a> »
      <span class="muted">{{ total }} voisin{{ total > 1 ? 's' : '' }} · {{ duree }} s</span>
    </div>
    {% else %}
    <div class="carte" data-testid="semblables-introuvable" style="border-color:var(--danger);padding:12px 16px;margin-bottom:12px">
      <strong>Document introuvable</strong> — il n’existe pas dans le fonds, ou vous n’avez pas le droit de le lire.
    </div>
    {% endif %}
  {% endif %}

  {% if erreur %}
  <div class="carte" data-testid="recherche-erreur" style="border-color:var(--danger);padding:12px 16px;margin-bottom:12px">
    <strong>Recherche impossible</strong> — étape « {{ erreur.etape }} », cause : {{ erreur.cause }}
    <span class="mono">(réf. {{ erreur.reference }})</span>
  </div>
  {% endif %}

  <section class="carte" data-testid="resultats" data-mode="{{ mode }}">
    {% for r in resultats %}
      <article class="resultat" data-testid="resultat-{{ r.id }}">
        <div class="resultat-tete">
          {% if r.id > 0 %}
            <a href="/documents/{{ r.id }}"><strong>{% for s in r.titre_segments %}{% if s.hit %}<mark>{{ s.t }}</mark>{% else %}{{ s.t }}{% endif %}{% endfor %}</strong></a>
          {% else %}
            <strong>{% for s in r.titre_segments %}{% if s.hit %}<mark>{{ s.t }}</mark>{% else %}{{ s.t }}{% endif %}{% endfor %}</strong>
          {% endif %}
          {% if r.type %}<span class="chip">{{ r.type }}</span>{% endif %}
          {% if r.emetteur %}<span class="muted">{{ r.emetteur }}</span>{% endif %}
          {% if r.date %}<span class="muted">{{ r.date|date('d.m.Y') }}</span>{% endif %}
          {% if r.montant is not null %}<span class="muted">{{ r.montant|number_format(2, '.', ' ') }} CHF</span>{% endif %}
        </div>
        {# V2-10c / V2-10e : seuls les extraits lisibles sont rendus (heuristique `ExtraitsLisibles`) — jamais
           un amas OCR brut. L'extrait est rattaché au document : il suit immédiatement son titre, AVANT le
           lien « Documents semblables », qui désigne une action et non l'extrait. #}
        {% if r.extraits %}
        <div class="extraits" data-testid="extraits-{{ r.id }}">
          {% for extrait in r.extraits %}
          <div class="muted">{% for s in extrait %}{% if s.hit %}<mark>{{ s.t }}</mark>{% else %}{{ s.t }}{% endif %}{% endfor %}</div>
          {% endfor %}
        </div>
        {% endif %}
        <div class="resultat-pied">
          {% if r.id > 0 %}
          <a class="btn discret" href="/recherche?semblable={{ r.id }}" data-testid="semblables-{{ r.id }}">Documents semblables</a>
          {% endif %}
        </div>
      </article>
    {% else %}
      {% if not erreur %}
      <article class="resultat" data-testid="recherche-vide">
        <strong>{% if semblable is defined and semblables_actifs %}Aucun document semblable{% else %}Aucun document ne correspond{% endif %}</strong>
        <div class="muted">{% if semblable is defined and semblables_actifs %}Rien de comparable dans le fonds : la liste de voisins reste vide, sans être masquée en silence.{% else %}Élargissez la requête ou retirez un filtre : rien n’est masqué en silence.{% endif %}</div>
      </article>
      {% endif %}
    {% endfor %}
  </section>
</div>
{% endblock %}
