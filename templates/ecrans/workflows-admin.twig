{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% block titre %}Administration des workflows{% endblock %}
{% block contenu %}
{# Écran d'ADMINISTRATION des workflows (réservé à `workflow.gerer`) : liste, création, activation,
   ordre et accès à l'historique des exécutions. Même modèle que le moteur : un déclencheur + une action. #}
<div class="page" data-testid="ecran-workflows-admin">
  <div class="page-tete">
    <div class="titre">
      <h1>Administration des workflows</h1>
      <span class="muted">{{ workflows|length }} workflow{{ workflows|length > 1 ? 's' }}</span>
    </div>
    <div class="actions">
      <a class="btn discret" href="/workflows" data-testid="lien-workflows">{{ ic.i('flux') }}Tous les workflows</a>
    </div>
  </div>

  {% if not installe %}
  <section class="carte" data-testid="admin-non-installe">
    <div class="panneau"><p class="muted">Le schéma du secteur n’est pas posé : lancez
      <span class="mono">php tools/installer.php</span>.</p></div>
  </section>
  {% else %}

  <section class="carte">
    <div class="volet-tete">{{ ic.i('plus') }}Créer un workflow</div>
    <form method="post" action="/workflows/admin" data-testid="formulaire-workflow">
      <input type="hidden" name="csrf" value="{{ csrf }}">
      <div class="champ"><label for="wf-nom">Nom</label>
        <input id="wf-nom" name="nom" data-testid="workflow-nom" placeholder="p. ex. Factures fournisseurs" maxlength="180" required></div>
      <div class="champ"><label for="wf-ordre">Ordre (les plus petits d’abord)</label>
        <input id="wf-ordre" name="ordre" data-testid="workflow-ordre" type="number" value="0" min="0" max="9999"></div>
      <div class="champ"><label for="wf-declencheur">Déclencheur</label>
        <select id="wf-declencheur" name="declencheur_type" data-testid="workflow-declencheur">
          {% for code, libelle in declencheurs %}<option value="{{ code }}">{{ libelle }}</option>{% endfor %}
        </select></div>
      <div class="champ"><label for="wf-filtre">Filtre</label>
        <select id="wf-filtre" name="declencheur_filtre" data-testid="workflow-filtre">
          {% for cle, libelle in filtres %}<option value="{{ cle }}">{{ libelle }}</option>{% endfor %}
        </select></div>
      <div class="champ"><label for="wf-filtre-valeur">Valeur du filtre</label>
        <input id="wf-filtre-valeur" name="declencheur_valeur" data-testid="workflow-filtre-valeur" placeholder="p. ex. *facture*"></div>
      <div class="champ"><label for="wf-action">Action</label>
        <select id="wf-action" name="action_type" data-testid="workflow-action">
          {% for code, libelle in actions %}<option value="{{ code }}">{{ libelle }}</option>{% endfor %}
        </select></div>
      <div class="champ"><label for="wf-champ">Champ visé</label>
        <select id="wf-champ" name="action_champ" data-testid="workflow-champ">
          {% for cle, libelle in champs %}<option value="{{ cle }}">{{ libelle }}</option>{% endfor %}
        </select></div>
      <div class="champ"><label for="wf-valeur">Valeur (vide = tout retirer)</label>
        <input id="wf-valeur" name="action_valeur" data-testid="workflow-valeur" placeholder="p. ex. Facture traitée"></div>
      <div class="champ"><label for="wf-actif">Actif dès la création</label>
        <input id="wf-actif" name="actif" data-testid="workflow-actif" type="checkbox" value="1" checked></div>
      <div style="padding:10px 14px"><button class="btn primaire" type="submit" data-testid="action-creer-workflow">Créer le workflow</button></div>
    </form>
  </section>

  <section class="carte">
    <div class="volet-tete">{{ ic.i('flux') }}Workflows définis</div>
    {% if workflows %}
    <div class="panneau">
      {% for w in workflows %}
      <div class="carte" data-testid="workflow-{{ w.id }}">
        <div class="volet-tete">
          <strong data-testid="workflow-nom-{{ w.id }}">{{ w.nom }}</strong>
          <span class="chip">ordre {{ w.ordre }}</span>
          {% if w.actif %}<span class="chip ok" data-testid="workflow-etat-{{ w.id }}">actif</span>
          {% else %}<span class="chip warn" data-testid="workflow-etat-{{ w.id }}">en veille</span>{% endif %}
          <a class="btn" href="/workflows/admin/{{ w.id }}" data-testid="editer-workflow-{{ w.id }}" style="margin-left:auto">{{ ic.i('reglages') }}Ouvrir</a>
        </div>
        <div class="panneau">
          <p class="l2" data-testid="workflow-declencheurs-{{ w.id }}">Déclencheurs : {{ w.declencheurs|join(' ; ') ?: 'aucun' }}</p>
          <p class="l2">Actions : {{ w.actions|join(', ') ?: 'aucune' }}</p>
          <p class="muted">Dernière exécution : {{ w.derniere_execution ?: 'jamais' }}</p>
          <form method="post" action="/workflows/admin/{{ w.id }}/basculer">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <input type="hidden" name="actif" value="{{ w.actif ? '0' : '1' }}">
            <button class="btn" type="submit" data-testid="basculer-workflow-{{ w.id }}">{{ w.actif ? 'Mettre en veille' : 'Activer' }}</button>
          </form>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="panneau"><p class="muted" data-testid="aucun-workflow">Aucun workflow : créez-en un ci-dessus.</p></div>
    {% endif %}
  </section>
  {% endif %}
</div>
{% endblock %}
