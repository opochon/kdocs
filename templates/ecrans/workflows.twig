{% extends 'layout.twig' %}
{% import 'partiels/icones.twig' as ic %}
{% block titre %}Workflows{% endblock %}
{% block contenu %}
{# Écran Workflows pour l'utilisateur : la liste des CIRCUITS et des RÈGLES. Le dessin se fait dans
   l'éditeur (repris du designer GEDv1), où vit aussi l'essai à blanc sur un vrai document. #}
<div class="page" data-testid="ecran-workflows">
  <div class="page-tete">
    <div class="titre">
      <h1>Workflows</h1>
      <span class="muted">{{ circuits|length }} circuit{{ circuits|length > 1 ? 's' }} · {{ regles|length }} règle{{ regles|length > 1 ? 's' }}</span>
    </div>
    <div class="actions">
      {% for g in gabarits %}
      <form method="post" action="/workflows/gabarits/{{ g.nom }}">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <button class="btn {{ g.installe ? '' : 'primaire' }}" type="submit" data-testid="action-installer-{{ g.nom }}"
          title="{{ g.description }}">{{ ic.i('plus') }}{{ g.installe ? 'Réinstaller' : 'Installer' }} « {{ g.libelle }} »</button>
      </form>
      {% endfor %}
      <form method="post" action="/workflows/circuits" class="actions">
        <input type="hidden" name="csrf" value="{{ csrf }}">
        <input id="circuit-nom" name="nom" data-testid="circuit-nom" aria-label="Nom du nouveau circuit"
          placeholder="Nom du circuit" maxlength="180" required>
        <button class="btn" type="submit" data-testid="action-nouveau-circuit">{{ ic.i('plus') }}Nouveau circuit</button>
      </form>
    </div>
  </div>

  {% if not installe %}
  <section class="carte" data-testid="workflows-non-installes">
    <div class="volet-tete">Workflows non installés</div>
    <div class="panneau">
      <p class="muted">Le schéma du secteur n’est pas posé : lancez <span class="mono">php tools/installer.php</span>
        pour créer les tables <span class="mono">workflow_*</span>.</p>
    </div>
  </section>
  {% else %}

  <section class="carte" data-testid="circuits">
    <div class="volet-tete">{{ ic.i('flux') }}Circuits <span class="muted">— états et transitions ; chaque transition a son droit</span></div>
    {% if circuits %}
    <div class="panneau">
      {% for c in circuits %}
      <div class="carte" data-testid="circuit-{{ c.id }}" data-circuit-id="{{ c.id }}">
        <div class="volet-tete">
          <strong>{{ c.nom }}</strong>
          {% if c.gabarit %}<span class="chip">gabarit {{ c.gabarit }}</span>{% endif %}
          {% if c.actif %}<span class="chip ok">actif</span>{% else %}<span class="chip warn">en veille</span>{% endif %}
          <a class="btn" href="/workflows/circuits/{{ c.id }}/editeur" data-testid="editer-circuit-{{ c.id }}"
            style="margin-left:auto">{{ ic.i('flux') }}Ouvrir l’éditeur</a>
        </div>
        <div class="flux">
          {% for e in c.etats %}
          <div class="noeud{{ e.initial ? ' condition' : '' }}" data-testid="etat-{{ c.id }}-{{ e.nom }}">{{ e.libelle }}</div>
          {% if not loop.last %}<span class="fleche"></span>{% endif %}
          {% endfor %}
        </div>
        <div class="panneau">
          {% if c.transitions %}
          <ul class="liste">
            {% for t in c.transitions %}
            <li class="l2">{{ t.de }} → {{ t.vers }} — {{ t.libelle ?: 'transition' }} <span class="mono">{{ t.permission }}</span></li>
            {% endfor %}
          </ul>
          {% else %}
          <p class="muted">Aucune transition : reliez deux états dans l’éditeur.</p>
          {% endif %}
          <p class="muted">Règles rattachées :
            {% if c.regles %}{% for r in c.regles %}<span class="chip">{{ r.nom }}</span>{% endfor %}
            {% else %}aucune pour l’instant{% endif %}</p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="panneau"><p class="muted">Aucun circuit pour l’instant : installez un gabarit ou créez un circuit.</p></div>
    {% endif %}
  </section>

  <section class="carte" data-testid="regles">
    <div class="volet-tete">Règles <span class="muted">— un déclencheur, des conditions, des actions</span></div>
    {% if regles %}
    <div class="panneau">
      {% for r in regles %}
      <div class="carte" data-testid="regle-{{ r.id }}">
        <div class="volet-tete">
          {{ r.nom }}
          <span class="chip">{{ declencheurs[r.declencheur]|default(r.declencheur) }}</span>
          {% if r.actif %}<span class="chip ok">actif</span>{% else %}<span class="chip warn">en veille</span>{% endif %}
          {% if r.gabarit %}<span class="chip">gabarit {{ r.gabarit }}</span>{% endif %}
          <form method="post" action="/workflows/regles/{{ r.id }}/basculer" style="margin-left:auto">
            <input type="hidden" name="csrf" value="{{ csrf }}">
            <input type="hidden" name="actif" value="{{ r.actif ? '0' : '1' }}">
            <button class="btn" type="submit" data-testid="regle-{{ r.id }}-basculer">{{ r.actif ? 'Mettre en veille' : 'Activer' }}</button>
          </form>
        </div>
        <div class="panneau">
          <p class="muted">Conditions :
            {% if r.conditions is empty %}toujours
            {% else %}{% for c in r.conditions %}{{ c.champ }} {{ c.operateur }} {{ c.valeur }}{% if not loop.last %} et {% endif %}{% endfor %}{% endif %}
            · Actions :
            {% for a in r.actions %}{{ a.type }}{% if a.circuit is defined and a.circuit %} « {{ a.circuit }} »{% endif %}{% if a.assigne is defined and a.assigne %} → {{ a.assigne }}{% endif %}{% if not loop.last %}, {% endif %}{% endfor %}
          </p>
        </div>
      </div>
      {% endfor %}
    </div>
    {% else %}
    <div class="panneau"><p class="muted">Aucune règle pour l’instant.</p></div>
    {% endif %}
  </section>

  <section class="carte" data-testid="journal">
    <div class="volet-tete">Journal <span class="muted">— ajout seul, {{ journal|length }} dernières entrées</span></div>
    {% if journal %}
    <table class="table">
      <thead><tr><th>Quand</th><th>Qui</th><th>Genre</th><th>Détail</th></tr></thead>
      <tbody>
        {% for j in journal %}
        <tr data-testid="journal-{{ j.id }}">
          <td class="mono">{{ j.quand }}</td>
          <td>{{ j.qui }}</td>
          <td><span class="chip">{{ j.genre }}</span></td>
          <td>{% if j.document_id %}<a href="/documents/{{ j.document_id }}">#{{ j.document_id }}</a> {% endif %}{{ j.resume }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <div class="panneau"><p class="muted">Aucune entrée pour l’instant.</p></div>
    {% endif %}
  </section>

  {% endif %}
</div>
{% endblock %}
