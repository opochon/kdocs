{% import 'partiels/icones.twig' as ic %}
<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block titre %}GED{% endblock %} · GED</title>
  <link rel="icon" href="/favicon.svg" type="image/svg+xml">
  <link rel="stylesheet" href="/assets/css/ged.css">
  <script nonce="{{ csp_nonce }}">try { const t = localStorage.getItem('ged-theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}</script>
</head>
<body>
<div class="app">
  {# Une seule source d'entrées de menu. Le compteur et les vues viennent du rail réel (Ged\Ui\Rail). #}
  {% set rail = rail() %}
  {% set menu = [
    {id: 'a-traiter', libelle: 'À traiter', icone: 'inbox', url: '/a-traiter', compte: rail.compte_a_traiter},
    {id: 'bibliotheque', libelle: 'Bibliothèque', icone: 'biblio', url: '/bibliotheque', compte: null},
    {id: 'recherche', libelle: 'Recherche', icone: 'loupe', url: '/recherche', compte: null},
    {id: 'workflows', libelle: 'Workflows', icone: 'flux', url: '/workflows', compte: null},
  ] %}
  <nav class="rail" aria-label="Navigation principale" data-testid="menu">
    <div class="marque"><i>G</i>GED</div>
    {% for m in menu %}
      <a href="{{ m.url }}" data-testid="menu-{{ m.id }}" {% if ecran == m.id %}aria-current="page"{% endif %}>
        {{ ic.i(m.icone) }}{{ m.libelle }}{% if m.compte %}<span class="compte">{{ m.compte }}</span>{% endif %}
      </a>
    {% endfor %}
    <div class="sep"></div>
    <div class="titre-section">Vues</div>
    {% for v in rail.vues %}
    <a href="/bibliotheque?vue={{ v.id }}" data-testid="menu-vue-{{ v.slug ?: v.id }}">{{ ic.i('vue') }}{{ v.nom }}</a>
    {% else %}
    <span class="muted" style="padding:7px 10px" data-testid="menu-vues-vide">Aucune vue enregistrée</span>
    {% endfor %}
    <div class="bas">
      <a href="/application" data-testid="menu-application" {% if ecran == 'application' %}aria-current="page"{% endif %}>{{ ic.i('reglages') }}Application</a>
    </div>
  </nav>

  <header class="top">
    <form class="recherche-globale" action="/recherche" role="search" data-testid="recherche-globale">
      {{ ic.i('loupe') }}
      <input name="q" placeholder="Rechercher dans tous les documents" data-invite-courte="Rechercher" aria-label="Rechercher" data-testid="recherche-globale-champ" autocomplete="off">
      <span class="kbd">Ctrl K</span>
    </form>
    <div class="droite">
      <button class="btn icone discret" type="button" data-action="theme" data-testid="bouton-theme" title="Thème clair / sombre">{{ ic.i('lune') }}</button>
      <span class="avatar" title="Olivier" data-testid="utilisateur">OP</span>
    </div>
  </header>

  <main class="contenu" id="contenu">
    {# Écrans d'ordinateur signalés sur téléphone (V2-10a) : accessibles, mais annoncés comme tels. La fiche
       document, la recherche et À traiter font partie du périmètre mobile (V2-10b) : `avis_ordinateur`
       permet à un écran de se retirer de la liste sans changer son entrée de rail. #}
    {% if ecran in ['bibliotheque', 'metadonnees', 'workflows', 'application'] and (avis_ordinateur ?? true) %}
    <div class="avis-ordinateur" role="note" data-testid="ecran-ordinateur">
      {{ ic.i('biblio') }}Cet écran est conçu pour l’ordinateur : sur téléphone, l’affichage reste complet mais dense.
    </div>
    {% endif %}
    {% block contenu %}{% endblock %}
  </main>

  {# Barre latérale → barre d'onglets en bas sur téléphone (V2-10a). Mêmes routes, mêmes droits. #}
  <nav class="onglets-bas" aria-label="Navigation téléphone" data-testid="onglets-bas">
    <a href="/a-traiter" data-testid="onglet-a-traiter" {% if ecran == 'a-traiter' %}aria-current="page"{% endif %}>
      {{ ic.i('inbox') }}<span>À traiter</span>{% if rail.compte_a_traiter %}<span class="compte">{{ rail.compte_a_traiter }}</span>{% endif %}
    </a>
    <a href="/recherche" data-testid="onglet-recherche" {% if ecran == 'recherche' %}aria-current="page"{% endif %}>
      {{ ic.i('loupe') }}<span>Recherche</span>
    </a>
    <a href="/deposer" data-testid="onglet-deposer" {% if ecran == 'deposer' %}aria-current="page"{% endif %}>
      {{ ic.i('plus') }}<span>Déposer</span>
    </a>
    <details class="onglet-plus">
      <summary data-testid="onglet-plus">{{ ic.i('vue') }}<span>Plus</span></summary>
      <div class="onglet-plus-liste">
        <a href="/bibliotheque" data-testid="onglet-bibliotheque">{{ ic.i('biblio') }}<span>Bibliothèque</span><small>écran conçu pour l’ordinateur</small></a>
        <a href="/metadonnees" data-testid="onglet-metadonnees">{{ ic.i('reglages') }}<span>Métadonnées</span><small>écran conçu pour l’ordinateur</small></a>
        <a href="/workflows" data-testid="onglet-workflows">{{ ic.i('flux') }}<span>Workflows</span><small>écran conçu pour l’ordinateur</small></a>
        <a href="/application" data-testid="onglet-application">{{ ic.i('reglages') }}<span>Application</span><small>écran conçu pour l’ordinateur</small></a>
      </div>
    </details>
  </nav>
</div>
<script src="/assets/js/ged.js" type="module"></script>
{# La visionneuse est un comportement partagé : chargée UNE fois pour tous les écrans qui incluent la macro
   `visionneuse.moteur` (À traiter, Bibliothèque, Fiche, Recherche). L'écran « À traiter » l'avait oubliée
   et restait sur « Chargement de l'aperçu… » ; le charger ici rend l'oubli impossible. Le script ne fait
   rien quand la page n'a pas de `[data-visionneuse]`, et pdf.js ne part qu'à la première visionneuse PDF. #}
<script src="/assets/js/visionneuse.js" type="module"></script>
</body>
</html>
