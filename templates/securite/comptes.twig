{% extends 'layout.twig' %}{% block contenu %}<h1>Comptes</h1><form method="post" action="/administration/comptes" data-testid="formulaire-compte"><input type="hidden" name="csrf" value="{{ csrf|default('') }}"><label>Adresse <input data-testid="compte-identifiant" name="identifiant" type="email" required></label><label>Mot de passe <input data-testid="compte-mot-de-passe" name="mot_de_passe" type="password" minlength="12" required></label><label>Rôle <select data-testid="compte-role" name="role"><option value="utilisateur">Utilisateur</option><option value="manager">Manager</option><option value="administrateur">Administrateur</option></select></label><button data-testid="action-creer-compte">Créer</button></form><a data-testid="action-comptes" href="/administration/comptes">Comptes</a>{% for compte in comptes %}<p data-testid="compte-{{ compte.id }}">{{ compte.identifiant }} — {{ compte.role }}</p>{% endfor %}{% endblock %}
