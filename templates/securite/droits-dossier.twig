{% extends 'layout.twig' %}{% block contenu %}<h1>Droits du dossier</h1><form method="post" action="/dossiers/{{ dossier }}/droits"><input type="hidden" name="csrf" value="{{ csrf|default('') }}"><select data-testid="droit-groupe" name="groupe">{% for regle in regles %}<option value="{{ regle.id }}">{{ regle.nom }}</option>{% endfor %}</select><select data-testid="droit-niveau" name="niveau"><option>lire</option><option>deposer</option><option>modifier</option><option>gerer</option></select><select data-testid="droit-decision" name="autorise"><option value="1">Autoriser</option><option value="0">Refuser</option></select><button data-testid="action-enregistrer-droit">Enregistrer</button></form>{% for regle in regles %}<p data-testid="regle-{{ regle.id }}">{{ regle.nom }} {{ regle.action_code|default('hérité') }}</p>{% endfor %}{% endblock %}
