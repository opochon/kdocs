{% extends 'layout.twig' %}{% block contenu %}<h1>Groupes</h1><form method="post" action="/administration/groupes" data-testid="formulaire-groupe"><input type="hidden" name="csrf" value="{{ csrf|default('') }}"><label>Nom <input data-testid="groupe-nom" name="nom" required></label><label>Rôle <select data-testid="groupe-role" name="role"><option value="utilisateur">Utilisateur</option><option value="manager">Manager</option></select></label><button data-testid="action-creer-groupe">Créer</button></form><a data-testid="action-groupes" href="/administration/groupes">Groupes</a>{% for groupe in groupes %}<p data-testid="groupe-{{ groupe.id }}">{{ groupe.nom }} — {{ groupe.role_code }}</p>{% endfor %}{% endblock %}
